{
  "name": "usinabr/usinadocs-core",
  "description": "Lightweight PHP core for Usina Docs.",
  "type": "project",
  "license": "MPL-2.0",
  "require": {
    "php": "^8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "slim/twig-view": "^3.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "UsinaDocs\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UsinaDocs\\Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "@php bin/migrate.php",
    "reset-admin": "@php bin/reset-admin.php",
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
