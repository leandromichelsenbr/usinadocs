USINADOCS_ENV=development
USINADOCS_DB_PATH=database/database.sqlite
USINADOCS_ADMIN_EMAIL=admin@example.test
USINADOCS_ADMIN_PASSWORD=change-this-password

# Optional news homepage (latest articles and editorial sections) at / and /pt/p/inicio.
# USINADOCS_SITE_NAME and USINADOCS_TIMEZONE only apply when it is enabled.
USINADOCS_NEWS_HOME=0
# USINADOCS_SITE_NAME="Usina News"
# USINADOCS_TIMEZONE=America/Sao_Paulo

# Optional provider login. Set mode to oauth to disable the password form.
# USINADOCS_AUTH_MODE=oauth
# USINADOCS_OAUTH_CONFIG=/path/outside/public/oauth.json

# Canonical origin for article sharing and scheduled social publication.
# Origem canônica para compartilhamento de artigos e publicação social agendada.
# USINADOCS_PUBLIC_ORIGIN=https://news.example.org
