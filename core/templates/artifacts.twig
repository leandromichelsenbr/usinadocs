<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Artefatos reutilizáveis · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1100px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem;border-bottom:1px solid #ddd;text-align:left;vertical-align:top}.draft{color:#8a5800}.published{color:#096b2e}.outdated{color:#8b1f2d;font-weight:700}form{display:inline}</style><body><main><p><a href="/admin">← Painel editorial</a></p><h1>Artefatos reutilizáveis</h1><p>Artefatos possuem identidade e revisões próprias para serem reutilizados em várias páginas sem duplicação.</p><p><a href="/admin/artifacts/new">Criar artefato</a></p><table><thead><tr><th>Artefato</th><th>Tipo</th><th>Português</th><th>English</th><th>Español</th><th>Ações</th></tr></thead><tbody>{% for artifact in artifacts %}<tr><td>{{ artifact.title }}<br><code>{{ artifact.slug }}</code></td><td>{{ artifact.artifact_type }}</td><td class="{{ artifact.status }}">{{ artifact.status == 'draft' ? 'rascunho' : 'publicado' }}<br><a href="/admin/artifacts/{{ artifact.id }}/history/pt">Histórico</a></td>{% for language in ['en','es'] %}{% set status=attribute(artifact,language ~ '_status') %}<td class="{{ status }}">{% if status != 'absent' %}<a href="/admin/artifacts/{{ artifact.id }}/history/{{ language }}">Histórico</a><br>{% endif %}{% if status == 'absent' %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/translations/{{ language }}"><button>Traduzir {{ language|upper }}</button></form>{% elseif status == 'draft' %}<a href="/admin/artifacts/{{ artifact.id }}/{{ language }}/edit">Editar {{ language|upper }}</a>{% elseif status == 'outdated' %}Revisão necessária <form method="post" action="/admin/artifacts/{{ artifact.id }}/translations/{{ language }}/refresh"><button>Criar rascunho atualizado</button></form>{% else %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/{{ language }}/revisions"><button>Revisar {{ language|upper }}</button></form>{% endif %}</td>{% endfor %}<td><a href="/admin/artifacts/{{ artifact.id }}/usages">Ver usos</a> · {% if artifact.status == 'draft' %}<a href="/admin/artifacts/{{ artifact.id }}/edit">Editar</a> <form method="post" action="/admin/artifacts/{{ artifact.id }}/publish"><button>Publicar</button></form>{% else %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/revisions"><button>Criar revisão</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6">Nenhum artefato reutilizável.</td></tr>{% endfor %}</tbody></table></main></body></html>
