<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Artefatos reutilizáveis · Usina Docs</title>
<style>body{font:16px system-ui;margin:2rem;max-width:1000px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem;border-bottom:1px solid #ddd;text-align:left}.draft{color:#8a5800}.published{color:#096b2e}form{display:inline}</style>
<body><main><p><a href="/admin">← Painel editorial</a></p><h1>Artefatos reutilizáveis</h1><p>Artefatos possuem identidade e revisões próprias para serem reutilizados em várias páginas sem duplicação.</p><p><a href="/admin/artifacts/new">Criar artefato</a></p>
<table><thead><tr><th>Artefato</th><th>Tipo</th><th>Português</th><th>English</th><th>Español</th><th>Ação</th></tr></thead><tbody>{% for artifact in artifacts %}<tr><td>{{ artifact.title }}<br><code>{{ artifact.slug }}</code></td><td>{{ artifact.artifact_type }}</td><td class="{{ artifact.status }}">{{ artifact.status == 'draft' ? 'rascunho' : 'publicado' }}</td><td class="{{ artifact.en_status }}">{% if artifact.en_status == 'absent' %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/translations/en"><button>Traduzir EN</button></form>{% elseif artifact.en_status == 'draft' %}<a href="/admin/artifacts/{{ artifact.id }}/en/edit">Editar EN</a>{% else %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/en/revisions"><button>Revisar EN</button></form>{% endif %}</td><td class="{{ artifact.es_status }}">{% if artifact.es_status == 'absent' %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/translations/es"><button>Traduzir ES</button></form>{% elseif artifact.es_status == 'draft' %}<a href="/admin/artifacts/{{ artifact.id }}/es/edit">Editar ES</a>{% else %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/es/revisions"><button>Revisar ES</button></form>{% endif %}</td><td><a href="/admin/artifacts/{{ artifact.id }}/usages">Ver usos</a> · {% if artifact.status == 'draft' %}<a href="/admin/artifacts/{{ artifact.id }}/edit">Editar</a> <form method="post" action="/admin/artifacts/{{ artifact.id }}/publish"><button>Publicar</button></form>{% else %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/revisions"><button>Criar revisão</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6">Nenhum artefato reutilizável.</td></tr>{% endfor %}</tbody></table>
</main></body></html>
