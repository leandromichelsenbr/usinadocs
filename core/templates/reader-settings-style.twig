.reader-settings { display: flex; flex-wrap: wrap; align-items: end; gap: .5rem .75rem; margin: 0; }
.reader-settings label { display: grid; gap: .15rem; font-size: .875rem; }
.reader-settings select, .reader-settings button { min-height: 2.25rem; padding: .3rem .55rem; font: inherit; }
.reader-settings select:focus-visible, .reader-settings button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
