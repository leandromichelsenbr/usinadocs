<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Usos de {{ artifact.title }} · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1000px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem;border-bottom:1px solid #ddd;text-align:left}.current{color:#096b2e}.outdated{color:#8a5800}.unpinned,.legacy_unpinned{color:#8b1f2d}</style><body><main><p><a href="/admin/artifacts">← Artefatos reutilizáveis</a></p><h1>Usos de {{ artifact.title }}</h1><p>Esta tela mostra apenas rascunhos ativos e revisões atualmente publicadas.</p><table><thead><tr><th>Página</th><th>Idioma</th><th>Revisão da página</th><th>Revisão do artefato</th><th>Estado</th></tr></thead><tbody>{% for usage in usages %}<tr><td>{% if usage.page_status == 'published' %}<a href="/{{ usage.language_code }}/p/{{ usage.slug }}">{{ usage.page_title }}</a>{% else %}<a href="/admin/pages/{{ usage.page_id }}{% if usage.language_code != 'pt' %}/{{ usage.language_code }}{% endif %}/edit">{{ usage.page_title }}</a>{% endif %}</td><td>{{ usage.language_code|upper }}</td><td>{{ usage.page_revision }} · {{ usage.page_status == 'draft' ? 'rascunho' : 'publicada' }}</td><td>{{ usage.pinned_revision_number|default('não fixada') }} / atual {{ usage.current_revision_number }}</td><td class="{{ usage.artifact_status }}">{{ {current:'atual',outdated:'atualização disponível',unpinned:'será fixada na publicação',legacy_unpinned:'publicação legada; crie uma revisão para fixar'}[usage.artifact_status] }}</td></tr>{% else %}<tr><td colspan="5">Este artefato ainda não é usado por páginas ativas.</td></tr>{% endfor %}</tbody></table></main></body></html>
