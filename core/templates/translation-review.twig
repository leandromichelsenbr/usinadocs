<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Revisão de traduções · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1100px}a{color:#075f9f}table{width:100%;border-collapse:collapse;margin-bottom:2rem}th,td{padding:.7rem;border-bottom:1px solid #ddd;text-align:left}.published{color:#096b2e}.draft{color:#8a5800}.outdated{color:#8b1f2d;font-weight:700}.absent{color:#666}form{display:inline}</style><body><main><p><a href="/admin">← Painel editorial</a></p><h1>Revisão de traduções</h1><p>Uma tradução exige revisão quando sua versão de origem em português foi substituída por uma publicação mais recente.</p><form method="get" action="/admin/translations"><input name="q" value="{{ search }}" placeholder="Buscar por título"><button>Buscar</button></form><h2>Páginas</h2><table><thead><tr><th>Página</th><th>Português</th><th>English</th><th>Español</th></tr></thead><tbody>{% for page in pages %}<tr><td>{{ page.title }}</td><td class="published">publicada · revisão {{ page.pt_number }}</td>{% for language in ['en','es'] %}{% set status=attribute(page,language ~ '_status') %}{% set slug=attribute(page,language ~ '_slug') %}<td class="{{ status }}">{% if status == 'published' %}<a href="/{{ language }}/p/{{ slug }}">publicada</a>{% elseif status == 'draft' %}<a href="/admin/pages/{{ page.id }}/{{ language }}/edit">Editar rascunho</a>{% elseif status == 'outdated' %}Revisão necessária <form method="post" action="/admin/pages/{{ page.id }}/translations/{{ language }}/refresh"><button>Criar rascunho atualizado</button></form>{% else %}<a href="/admin/pages/{{ page.id }}/translations/{{ language }}/new">Incluir tradução</a>{% endif %}</td>{% endfor %}</tr>{% else %}<tr><td colspan="4">Nenhuma página publicada encontrada.</td></tr>{% endfor %}</tbody></table><h2>Artefatos reutilizáveis</h2><table><thead><tr><th>Artefato</th><th>Português</th><th>English</th><th>Español</th></tr></thead><tbody>{% for artifact in artifacts %}<tr><td>{{ artifact.title }}</td><td class="{{ artifact.status }}">{{ artifact.status == 'draft' ? 'rascunho' : 'publicado' }}</td>{% for language in ['en','es'] %}{% set status=attribute(artifact,language ~ '_status') %}<td class="{{ status }}">{% if status == 'published' %}publicada{% elseif status == 'draft' %}<a href="/admin/artifacts/{{ artifact.id }}/{{ language }}/edit">Editar rascunho</a>{% elseif status == 'outdated' %}Revisão necessária <form method="post" action="/admin/artifacts/{{ artifact.id }}/translations/{{ language }}/refresh"><button>Criar rascunho atualizado</button></form>{% else %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/translations/{{ language }}"><button>Incluir tradução</button></form>{% endif %}</td>{% endfor %}</tr>{% else %}<tr><td colspan="4">Nenhum artefato encontrado.</td></tr>{% endfor %}</tbody></table></main></body></html>
