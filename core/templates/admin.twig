<!doctype html><html lang="pt"><meta charset="utf-8"><title>Administração · Usina Docs</title><body><main><header><strong>Usina Docs</strong><form method="post" action="/logout"><button>Sair</button></form></header><h1>Painel editorial</h1><p>Olá, {{ user.name }}.</p><p><a href="/admin/pages/new">Criar página</a></p><h2>Rascunhos</h2>{% for page in drafts %}<article><strong>{{ page.title }}</strong> · /pt/p/{{ page.slug }} <form method="post" action="/admin/pages/{{ page.id }}/publish"><button>Publicar</button></form></article>{% else %}<p>Nenhum rascunho.</p>{% endfor %}</main></body></html>
