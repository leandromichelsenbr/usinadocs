<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administração · Usina Docs</title><body><main><header><strong>Usina Docs</strong><form method="post" action="/logout"><button>Sair</button></form></header><h1>Painel editorial</h1><p>Olá, {{ user.name }}.</p><p><a href="/admin/pages/new">Criar página</a></p><h2>Rascunhos</h2>{% for page in drafts %}<article><strong>{{ page.title }}</strong> · /pt/p/{{ page.slug }} <a href="/admin/pages/{{ page.id }}/edit">Editar</a><form method="post" action="/admin/pages/{{ page.id }}/publish"><button>Publicar</button></form></article>{% else %}<p>Nenhum rascunho.</p>{% endfor %}<h2>Publicadas</h2>{% for page in published %}<article><strong>{{ page.title }}</strong> · revisão {{ page.number }} · <a href="/pt/p/{{ page.slug }}">Ver</a><form method="post" action="/admin/pages/{{ page.id }}/revisions"><button>Criar revisão</button></form></article>{% else %}<p>Nenhuma página publicada.</p>{% endfor %}</main></body></html>
