<!doctype html><html lang="pt"><meta charset="utf-8"><title>Administração · Usina Docs</title><body><main><header><strong>Usina Docs</strong><form method="post" action="/logout"><button>Sair</button></form></header><h1>Painel editorial</h1><p>Olá, {{ user.name }}.</p><p><a href="/admin/pages/new">Criar página</a></p><h2>Rascunhos em português</h2>{% for page in drafts %}<article><strong>{{ page.title }}</strong> <a href="/admin/pages/{{ page.id }}/edit">Editar</a><form method="post" action="/admin/pages/{{ page.id }}/publish"><button>Publicar</button></form></article>{% else %}<p>Nenhum rascunho.</p>{% endfor %}<h2>Publicadas em português</h2>{% for page in published %}<article><strong>{{ page.title }}</strong> · <a href="/pt/p/{{ page.slug }}">Ver</a><form method="post" action="/admin/pages/{{ page.id }}/revisions"><button>Revisar PT</button></form><details><summary>Traduções</summary><form method="post" action="/admin/pages/{{ page.id }}/translations/en"><label>Endereço em inglês <input name="slug" required pattern="[a-z0-9-]+" placeholder="advpl-basics"></label><button>Criar inglês</button></form><form method="post" action="/admin/pages/{{ page.id }}/translations/es"><label>Endereço em espanhol <input name="slug" required pattern="[a-z0-9-]+" placeholder="fundamentos-advpl"></label><button>Criar espanhol</button></form></details></article>{% else %}<p>Nenhuma página publicada.</p>{% endfor %}</main></body></html>
