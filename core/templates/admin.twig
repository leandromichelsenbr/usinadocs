<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administração · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1000px}header,article,form{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}header{justify-content:space-between}table{width:100%;border-collapse:collapse}th,td{padding:.7rem;border-bottom:1px solid #ddd;text-align:left}.published{color:#096b2e}.draft{color:#8a5800}.absent,.missing{color:#8b1f2d}</style><body><main><header><strong>Usina Docs</strong><form method="post" action="/logout"><button>Sair</button></form></header><h1>Painel editorial</h1><p>Olá, {{ user.name }}.</p><p><a href="/admin/pages/new">Criar página</a></p><h2>Catálogo editorial</h2><form method="get" action="/admin"><input name="q" value="{{ search }}" placeholder="Buscar por título"><button>Buscar</button></form><table><thead><tr><th>Página</th><th>Português</th><th>English</th><th>Español</th></tr></thead><tbody>{% for page in catalog %}<tr><td>{{ page.title }}</td><td class="{{ page.pt_status }}">{{ page.pt_status }}</td><td class="{{ page.en_status }}">{{ page.en_status }}</td><td class="{{ page.es_status }}">{{ page.es_status }}</td></tr>{% else %}<tr><td colspan="4">Nenhuma página encontrada.</td></tr>{% endfor %}</tbody></table><h2>Rascunhos em português</h2>{% for page in drafts %}<article><strong>{{ page.title }}</strong><a href="/admin/pages/{{ page.id }}/edit">Editar</a><form method="post" action="/admin/pages/{{ page.id }}/publish"><button>Publicar</button></form></article>{% else %}<p>Nenhum rascunho.</p>{% endfor %}<h2>Publicadas em português</h2>{% for page in published %}<article><strong>{{ page.title }}</strong><a href="/pt/p/{{ page.slug }}">Ver</a><form method="post" action="/admin/pages/{{ page.id }}/revisions"><button>Revisar PT</button></form><details><summary>Traduções</summary><form method="post" action="/admin/pages/{{ page.id }}/translations/en"><input name="slug" required placeholder="endereço em inglês"><button>Criar inglês</button></form><form method="post" action="/admin/pages/{{ page.id }}/translations/es"><input name="slug" required placeholder="endereço em espanhol"><button>Criar espanhol</button></form></details></article>{% else %}<p>Nenhuma página publicada.</p>{% endfor %}</main></body></html>
