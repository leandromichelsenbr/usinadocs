{% set copy = reader_preferences.text %}
{% set labels = editorial_labels[reader_preferences.language]|merge({sections: editor_form_labels[reader_preferences.language].sections}) %}
{% set site_label = site_appearance.display_name ?: site_default_name|default('Usina Docs') %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ copy.panel }} · {{ site_label }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-controls-style.twig' %}
        :root { color-scheme: light; }
        :root[data-theme="dark"] { color-scheme: dark; }
        @media (prefers-color-scheme: dark) { :root[data-theme="auto"] { color-scheme: dark; } }
        body { font: 1rem/1.45 system-ui, sans-serif; margin: 2rem; max-width: 1200px; background: light-dark(#fff, #0e1624); color: light-dark(#172033, #edf3ff); }
        header, .nav, .search, .actions { display: flex; gap: .65rem; align-items: center; flex-wrap: wrap; }
        header { justify-content: space-between; }
        .nav { padding: .9rem 0; border-block: 1px solid light-dark(#d8dee9, #32435d); }
        .search { margin: 1rem 0; }
        .search input { width: min(100%, 18rem); padding: .5rem; }
        .catalog { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .8rem; border-bottom: 1px solid light-dark(#ddd, #32435d); text-align: left; vertical-align: top; }
        th { background: light-dark(#f5f7fa, #17263a); }
        .page-title { min-width: 13rem; }
        .language-cell { min-width: 14rem; }
        .actions { margin-block: .35rem; }
        .actions form { margin: 0; }
        a { color: inherit; }
        button { font: inherit; cursor: pointer; }
        .status { display: inline-block; padding: .15rem .45rem; border-radius: .3rem; font-size: .8rem; font-weight: 700; background: light-dark(#eef2f8, #273850); }
        .status.hidden, .status.draft { background: light-dark(#fff1d7, #3b2e15); }
        .status.published { background: light-dark(#dbf1e5, #203c33); }
        @media (max-width: 48rem) { body { margin: 1rem; } }
    </style>
</head>
<body><main class="reader-screen">
    <header>
        <strong>{{ site_label }}</strong>
        <div class="actions">
            {% include 'reader-language.twig' with {query: search != '' ? {q: search} : {}} only %}
            <a href="/">{{ labels.homepage }}</a>
            <form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf_token() }}"><button>{{ copy.sign_out }}</button></form>
        </div>
    </header>
    <h1>{{ copy.panel }}</h1>
    <p>{{ labels.hello }} {{ user.name }}.</p>
    <nav class="nav" aria-label="{{ copy.panel }}">
        {% if can_manage_appearance %}
            <a href="/admin/appearance">{{ labels.appearance }}</a>
            <a href="/admin/legal">{{ labels.legal }}</a>
            {# The external publishing settings are available only to administrators.
               As configurações de publicação externa estão disponíveis apenas para administradores. #}
            <a href="/admin/social">{{ {pt: 'Redes sociais', en: 'Social networks', es: 'Redes sociales'}[reader_preferences.language] }}</a>
        {% endif %}
        {% if can_manage_users %}<a href="/admin/users">{{ labels.users }}</a>{% endif %}
        {% for path, label in {
            'pages/new': 'new_page', sections: 'sections', authors: 'authors', comments: 'comments', 'article-views': 'views',
            models: 'models', artifacts: 'artifacts', media: 'media', translations: 'translations', packages: 'packages'
        } %}
            <a href="/admin/{{ path }}">{{ labels[label] }}</a>
        {% endfor %}
    </nav>
    <h2>{{ labels.catalog }}</h2>
    <form class="search" method="get" action="/admin">
        <input name="q" value="{{ search }}" placeholder="{{ labels.search_title }}" aria-label="{{ labels.search_title }}">
        <button>{{ labels.search }}</button>
    </form>
    <div class="catalog"><table>
        <thead><tr><th scope="col">{{ labels.page }}</th>{% for code, name in reader_preferences.languages %}<th scope="col" lang="{{ code }}">{{ name }}</th>{% endfor %}</tr></thead>
        <tbody>
        {% for page in catalog %}
            {% set admin_page = '/admin/pages/' ~ page.id %}
            <tr>
                <td class="page-title">
                    <strong>{{ page.title }}</strong>
                    {% if page.hidden %}<span class="status hidden">{{ labels.hidden }}</span>{% endif %}
                    <div class="actions"><a href="{{ admin_page }}/release">{{ labels.release }}</a></div>
                    {% if page.pt_status == 'published' %}
                        <div class="actions"><a href="{{ admin_page }}/export">{{ labels.export }}</a></div>
                        {# Visibility is an article-wide action. It leaves editions and drafts available to editors.
                           A visibilidade vale para o artigo inteiro. Edições e rascunhos continuam disponíveis aos editores. #}
                        {% if page.content_type == 'article' or page.hidden %}
                            <form method="post" action="{{ admin_page }}/visibility">
                                <input type="hidden" name="csrf" value="{{ csrf_token() }}">
                                <input type="hidden" name="q" value="{{ search }}">
                                <button type="submit" name="hidden" value="{{ page.hidden ? '0' : '1' }}">{{ page.hidden ? labels.show : labels.hide }}</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </td>
                {% for code in reader_preferences.languages|keys %}
                    {% set status = page[code ~ '_status'] %}
                    {% set draft = page[code ~ '_has_draft'] %}
                    {% set edit_path = admin_page ~ (code == 'pt' ? '' : '/' ~ code) %}
                    <td class="language-cell">
                        {% if status == 'published' and not page.hidden %}
                            <a class="status published" href="/{{ code }}/p/{{ page[code ~ '_slug']|url_encode }}">{{ labels.published }}</a>
                        {% else %}
                            <span class="status {{ status }}">{{ labels[status] }}</span>
                        {% endif %}
                        <div class="actions">
                            {% if status not in ['missing', 'absent'] %}<a href="{{ admin_page }}/history/{{ code }}">{{ labels.history }}</a>{% endif %}
                            {% if draft %}
                                <a href="{{ edit_path }}/edit">{{ labels.edit_draft }}</a>
                                <form method="post" action="{{ edit_path }}/publish"><input type="hidden" name="csrf" value="{{ csrf_token() }}"><button>{{ labels.publish }}</button></form>
                                <a href="{{ admin_page }}/revisions/{{ code }}/discard">{{ labels.discard }}</a>
                            {% elseif status == 'published' %}
                                <form method="post" action="{{ admin_page }}/revisions{% if code != 'pt' %}/{{ code }}{% endif %}"><input type="hidden" name="csrf" value="{{ csrf_token() }}"><button>{{ labels.new_revision }}</button></form>
                            {% elseif code != 'pt' and status == 'absent' %}
                                <a href="{{ admin_page }}/translations/{{ code }}/new">{{ labels.new_translation }}</a>
                            {% endif %}
                        </div>
                    </td>
                {% endfor %}
            </tr>
        {% else %}
            <tr><td colspan="4">{{ labels.empty }}</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
</main>
{% include 'reader-theme.twig' with {query: search != '' ? {q: search} : {}} only %}
</body></html>
