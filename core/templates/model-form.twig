<!doctype html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ model ? 'Editar modelo' : 'Novo modelo' }} · Usina Docs</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.item{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}.tools{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}.check{display:flex;width:auto;gap:.5rem}.check input{width:auto}</style></head><body><main><p><a href="/admin/models">← Modelos editoriais</a></p><p>Editor de conteúdo · <strong>Modelo</strong></p><h1>{{ model ? 'Editar modelo' : 'Novo modelo' }}</h1><form id="editor" method="post" action="{{ model ? '/admin/models/' ~ model.id : '/admin/models' }}"><label>Categoria <select disabled><option>Modelo</option></select></label><label>Identificador técnico <input name="content_type" required pattern="[a-z][a-z0-9_]*" value="{{ model.content_type|default('') }}" {% if model %}readonly{% endif %}></label><label>Nome <input name="label" required value="{{ model.label|default('') }}"></label><label>Descrição <textarea name="description" required>{{ model.description|default('') }}</textarea></label><h2>Artefatos permitidos</h2><div id="artifacts"></div><div class="tools"><button type="button" id="add">Adicionar artefato</button></div><input type="hidden" name="artifacts_json" id="artifacts-json"><p><button>Salvar rascunho</button></p></form>{% if model %}<form method="post" action="/admin/models/{{ model.id }}/publish"><button>Publicar modelo</button></form>{% endif %}</main><script id="initial-artifacts" type="application/json">{{ artifacts|default([])|json_encode|raw }}</script><script>
const allowed={heading:'Título de seção',text:'Texto',code:'Código',table:'Tabela',diagram:'Diagrama',quiz:'Quiz',image:'Imagem',reference:'Referência',citation:'Citação',notice:'Aviso'};let artifacts=JSON.parse(document.querySelector('#initial-artifacts').textContent);const host=document.querySelector('#artifacts');
function render(){host.replaceChildren();artifacts.forEach((artifact,index)=>{const card=document.createElement('section');card.className='item';const row=document.createElement('div');row.className='tools';const type=document.createElement('select');Object.entries(allowed).forEach(([value,label])=>type.add(new Option(label,value,false,value===artifact.type)));type.onchange=event=>artifact.type=event.target.value;const label=document.createElement('input');label.placeholder='Nome exibido no editor';label.value=artifact.label||'';label.oninput=event=>artifact.label=event.target.value;const required=document.createElement('label');required.className='check';const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.checked=!!artifact.required;checkbox.onchange=event=>artifact.required=event.target.checked;required.append(checkbox,'Obrigatório');row.append(type,label,required);[['↑',-1],['↓',1]].forEach(([text,direction])=>{const button=document.createElement('button');button.type='button';button.textContent=text;button.onclick=()=>move(index,direction);row.append(button)});const remove=document.createElement('button');remove.type='button';remove.textContent='Remover';remove.onclick=()=>{artifacts.splice(index,1);render()};row.append(remove);card.append(row);host.append(card)})}
function move(index,direction){const target=index+direction;if(target<0||target>=artifacts.length)return;[artifacts[index],artifacts[target]]=[artifacts[target],artifacts[index]];render()}document.querySelector('#add').onclick=()=>{artifacts.push({type:'text',label:'Texto',required:false});render()};document.querySelector('#editor').onsubmit=()=>document.querySelector('#artifacts-json').value=JSON.stringify(artifacts);render();
</script></body></html>
