<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Comparar revisões · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1200px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.card{border:1px solid #ccd4e0;padding:1rem;border-radius:.5rem}.changed{border-color:#d69200;background:#fff8e6}pre{white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style><body><main><p><a href="/admin/pages/{{ page_id }}/history/{{ language }}">← Histórico</a></p><h1>Comparar revisões {{ comparison.from.number }} e {{ comparison.to.number }}</h1><div class="grid"><section class="card"><h2>Revisão {{ comparison.from.number }}</h2><p><strong>{{ comparison.from.title }}</strong></p><p>{{ comparison.from.summary }}</p></section><section class="card"><h2>Revisão {{ comparison.to.number }}</h2><p><strong>{{ comparison.to.title }}</strong></p><p>{{ comparison.to.summary }}</p></section></div><h2>Blocos</h2>{% for row in comparison.blocks %}<div class="grid"><section class="card {{ row.changed ? 'changed' : '' }}"><strong>Posição {{ row.position }}</strong>{% if row.from %}<p>{{ row.from.type }}</p><pre>{{ row.from.data|json_encode }}</pre>{% else %}<p>Sem bloco</p>{% endif %}</section><section class="card {{ row.changed ? 'changed' : '' }}"><strong>Posição {{ row.position }}</strong>{% if row.to %}<p>{{ row.to.type }}</p><pre>{{ row.to.data|json_encode }}</pre>{% else %}<p>Sem bloco</p>{% endif %}</section></div>{% endfor %}</main></body></html>
