{% set labels = editorial_labels[reader_preferences.language] %}
{% set fields = editor_form_labels[reader_preferences.language] %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ fields.byline }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
        label{display:block;margin:.55rem 0}fieldset{margin-block:1rem}button{font:inherit;padding:.55rem .9rem}
    </style>
</head>
<body><main class="reader-screen">
    <p><a href="/admin/pages/{{ page_id }}/release">{{ labels.release }}</a></p>
    {% include 'reader-language.twig' only %}
    <h1>{{ fields.byline }}</h1>
    <p>{{ fields.byline_note }}</p>
    <p><a href="/admin/authors">{{ fields.edit_bios }}</a></p>
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    {% if directory %}
        <form method="post" data-warn-unsaved action="/admin/pages/{{ page_id }}/authors">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <fieldset>
                <legend>{{ labels.authors }}</legend>
                {% for author in directory %}
                    <label><input type="checkbox" name="authors[]" value="{{ author.slug }}"{{ author.slug in selected ? ' checked' }}> {{ author.name }}</label>
                {% endfor %}
            </fieldset>
            <button type="submit">{{ fields.save_byline }}</button>
        </form>
    {% endif %}
</main>
{% include 'reader-theme.twig' only %}
{% include 'editor-unsaved.twig' only %}
</body>
</html>
