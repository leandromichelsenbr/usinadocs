{# A stable key groups the articles across languages. This form edits only the displayed names.
   A chave estável reúne as matérias nos três idiomas. Este formulário edita os nomes exibidos. #}
{% set copy = {
    pt: {intro: 'Selecione uma hashtag para informar os nomes em inglês e espanhol. Para nomes técnicos ou universais, marque Usar o mesmo nome nos três idiomas.', pending: 'Aguardando tradução ou confirmação', same: 'Usar o mesmo nome nos três idiomas', english: 'Nome em inglês', spanish: 'Nome em espanhol', save: 'Salvar', saved: 'Hashtag atualizada.', invalid: 'Informe os dois nomes. Use letras, números, hífen ou sublinhado.', empty: 'Adicione hashtags a uma matéria para gerenciá-las aqui.'},
    en: {intro: 'Choose a hashtag to add its English and Spanish names. For technical or universal names, select Use the same name in all three languages.', pending: 'Awaiting translation or confirmation', same: 'Use the same name in all three languages', english: 'English name', spanish: 'Spanish name', save: 'Save', saved: 'Hashtag updated.', invalid: 'Enter both names. Use letters, numbers, hyphens or underscores.', empty: 'Add hashtags to an article to manage them here.'},
    es: {intro: 'Selecciona una hashtag para indicar los nombres en inglés y español. Para nombres técnicos o universales, marca Usar el mismo nombre en los tres idiomas.', pending: 'Pendiente de traducción o confirmación', same: 'Usar el mismo nombre en los tres idiomas', english: 'Nombre en inglés', spanish: 'Nombre en español', save: 'Guardar', saved: 'Hashtag actualizada.', invalid: 'Indica ambos nombres. Usa letras, números, guiones o guiones bajos.', empty: 'Añade hashtags a un artículo para gestionarlas aquí.'}
}[reader_preferences.language] %}
{% set prefs = selected ? {tag: selected.key} : {} %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Hashtags · Usina Docs</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
        /* Keep long names and their status readable on narrow screens.
           Mantém nomes longos e seus estados legíveis em telas estreitas. */
        main { max-width: 48rem; }
        form { display: grid; gap: .65rem; margin-block: 1rem; }
        label, li { overflow-wrap: anywhere; }
        input, button { max-width: 100%; font: inherit; }
        form button { justify-self: start; }
    </style>
</head>
<body><main class="reader-screen">
    <p><a href="/admin">{{ reader_preferences.text.panel }}</a></p>
    {% include 'reader-language.twig' with {query: prefs} only %}
    <h1>Hashtags</h1>
    <p>{{ copy.intro }}</p>
    {% if saved %}<p role="status">{{ copy.saved }}</p>{% endif %}
    {% if invalid %}<p role="alert">{{ copy.invalid }}</p>{% endif %}
    {% if selected %}
        <h2>#{{ selected.label }}</h2>
        <form method="post" action="/admin/hashtags">
            <input type="hidden" name="csrf" value="{{ csrf_token() }}">
            <input type="hidden" name="tag" value="{{ selected.key }}">
            <label><input type="checkbox" name="universal" value="1"{% if not invalid and selected.rule and selected.rule.label_en is null %} checked{% endif %}> {{ copy.same }}</label>
            <label>{{ copy.english }} <input name="label_en" maxlength="60" value="{{ invalid.label_en ?? selected.rule.label_en }}"></label>
            <label>{{ copy.spanish }} <input name="label_es" maxlength="60" value="{{ invalid.label_es ?? selected.rule.label_es }}"></label>
            <button type="submit">{{ copy.save }}</button>
        </form>
    {% endif %}
    {% if catalog %}
        <ul>
            {% for item in catalog %}
                <li><a href="?{{ {tag: item.key}|url_encode }}"{% if selected.key == item.key %} aria-current="page"{% endif %}>#{{ item.label }}</a>
                    {% if item.rule is null %} · {{ copy.pending }}
                    {% elseif item.rule.label_en %} · #{{ item.rule.label_en }} · #{{ item.rule.label_es }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>{{ copy.empty }}</p>
    {% endif %}
</main>
{% include 'reader-theme.twig' with {query: prefs} only %}
</body>
</html>
