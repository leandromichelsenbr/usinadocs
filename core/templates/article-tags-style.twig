/* Let tags wrap naturally alongside long headings and narrow cards.
   Permite que as hashtags quebrem linha em títulos longos e chamadas estreitas. */
.article-tags { display: flex; flex-wrap: wrap; gap: .3rem .65rem; list-style: none; padding: 0; margin: .45rem 0; }
.article-tags a { color: inherit; font-size: .88rem; text-underline-offset: .18em; overflow-wrap: anywhere; }
