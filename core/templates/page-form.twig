<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page ? 'Editar rascunho' : 'Nova página' }}</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.block{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}.tools{display:flex;gap:.5rem;flex-wrap:wrap}</style><body><main><h1>{{ page ? 'Editar rascunho ' ~ (page.language|default('pt')|upper) : 'Nova página' }}</h1><form id="editor" method="post" action="{{ page and page.language is defined ? '/admin/pages/' ~ page.page_id ~ '/' ~ page.language : (page ? '/admin/pages/' ~ page.page_id : '/admin/pages') }}"><label>Título <input name="title" required value="{{ page.title|default('') }}"></label>{% if not page %}<label>Endereço <input name="slug" required pattern="[a-z0-9-]+"></label>{% endif %}<label>Resumo <textarea name="summary">{{ page.summary|default('') }}</textarea></label><h2>Blocos</h2><div id="blocks"></div><div class="tools">{% for type,label in {heading:'Título de seção',text:'Texto',code:'Código',image:'Imagem',reference:'Referência',notice:'Aviso'} %}<button type="button" data-add="{{ type }}">Adicionar {{ label }}</button>{% endfor %}</div><input type="hidden" name="blocks_json" id="blocks-json"><p><button>Salvar rascunho</button></p></form>{% if page and page.language is defined and page.language != 'pt' %}<form method="post" action="/admin/pages/{{ page.page_id }}/{{ page.language }}/publish"><button>Publicar tradução</button></form>{% endif %}<p><a href="/admin">Cancelar</a></p></main><script>const initial={{ blocks|default([])|json_encode|raw }},media={{ media|default([])|json_encode|raw }},host=document.querySelector('#blocks');let blocks=initial.length?initial:[{type:'text',data:{body:''}}];const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function field(b){let d=b.data||{};if(b.type==='heading')return`<label>Título <input data-key="text" value="${esc(d.text)}"></label>`;if(b.type==='code')return`<label>Código <textarea data-key="code">${esc(d.code)}</textarea></label>`;if(b.type==='image')return`<label>Imagem <select data-key="id"><option value="">Selecione</option>${media.map(m=>`<option value="${m.id}" ${d.id===m.id?'selected':''}>${esc(m.title)}</option>`).join('')}</select></label>`;if(b.type==='reference')return`<label>Referência <input data-key="title" value="${esc(d.title)}"></label><label>URL <input data-key="url" value="${esc(d.url)}"></label>`;return`<label>${b.type==='notice'?'Aviso':'Texto'} <textarea data-key="body">${esc(d.body)}</textarea></label>`}function render(){host.innerHTML=blocks.map((b,i)=>`<section class="block" data-i="${i}"><div class="tools"><strong>${b.type}</strong><button type="button" data-up="${i}">↑</button><button type="button" data-down="${i}">↓</button><button type="button" data-remove="${i}">Remover</button></div>${field(b)}</section>`).join('')}host.querySelectorAll('[data-key]').forEach(el=>el.oninput=e=>{let i=+e.target.closest('.block').dataset.i;blocks[i].data[e.target.dataset.key]=e.target.value});host.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{blocks.splice(+b.dataset.remove,1);render()});host.querySelectorAll('[data-up]').forEach(b=>b.onclick=()=>{let i=+b.dataset.up;if(i){[blocks[i-1],blocks[i]]=[blocks[i],blocks[i-1]];render()}});host.querySelectorAll('[data-down]').forEach(b=>b.onclick=()=>{let i=+b.dataset.down;if(i<blocks.length-1){[blocks[i+1],blocks[i]]=[blocks[i],blocks[i+1]];render()}})}document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{blocks.push({type:b.dataset.add,data:{}});render()});document.querySelector('#editor').onsubmit=()=>document.querySelector('#blocks-json').value=JSON.stringify(blocks);render();</script></body></html>
