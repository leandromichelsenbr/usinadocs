<!doctype html>
<html lang="pt">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page ? 'Editar rascunho' : 'Nova página' }}</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.block{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}.tools{display:flex;gap:.5rem;flex-wrap:wrap}</style></head>
<body><main><h1>{{ page ? 'Editar rascunho ' ~ (page.language|default('pt')|upper) : 'Nova página' }}</h1><form id="editor" method="post" action="{{ page and page.language is defined ? '/admin/pages/' ~ page.page_id ~ '/' ~ page.language : (page ? '/admin/pages/' ~ page.page_id : '/admin/pages') }}"><label>Título <input name="title" required value="{{ page.title|default('') }}"></label>{% if not page %}<label>Endereço <input name="slug" required pattern="[a-z0-9-]+"></label>{% endif %}<label>Resumo <textarea name="summary">{{ page.summary|default('') }}</textarea></label><h2>Blocos</h2><div id="blocks"></div><div class="tools">{% for type,label in {heading:'Título de seção',text:'Texto',code:'Código',image:'Imagem',reference:'Referência',notice:'Aviso'} %}<button type="button" data-add="{{ type }}">Adicionar {{ label }}</button>{% endfor %}</div><input type="hidden" name="blocks_json" id="blocks-json"><p><button>Salvar rascunho</button></p></form>{% if page and page.language is defined and page.language != 'pt' %}<form method="post" action="/admin/pages/{{ page.page_id }}/{{ page.language }}/publish"><button>Publicar tradução</button></form>{% endif %}<p><a href="/admin">Cancelar</a></p></main>
<script id="initial-blocks" type="application/json">{{ blocks|default([])|json_encode|raw }}</script><script id="available-media" type="application/json">{{ media|default([])|json_encode|raw }}</script>
<script>
const host = document.querySelector('#blocks');
const initialBlocks = JSON.parse(document.querySelector('#initial-blocks').textContent);
const media = JSON.parse(document.querySelector('#available-media').textContent);
let blocks = initialBlocks.length ? initialBlocks : [{type: 'text', data: {body: ''}}];
function control(label, key, value, tag = 'textarea') {
  const wrapper = document.createElement('label'); wrapper.textContent = label;
  const input = document.createElement(tag); input.dataset.key = key; input.value = value || ''; wrapper.append(input); return wrapper;
}
function render() {
  host.replaceChildren();
  blocks.forEach((block, index) => {
    const card = document.createElement('section'); card.className = 'block';
    const tools = document.createElement('div'); tools.className = 'tools'; tools.innerHTML = `<strong>${block.type}</strong>`;
    [['↑', () => move(index, -1)], ['↓', () => move(index, 1)], ['Remover', () => { blocks.splice(index, 1); render(); }]].forEach(([label, action]) => { const button = document.createElement('button'); button.type = 'button'; button.textContent = label; button.onclick = action; tools.append(button); }); card.append(tools);
    const data = block.data || (block.data = {});
    if (block.type === 'heading') card.append(control('Título da seção', 'text', data.text, 'input'));
    else if (block.type === 'code') card.append(control('Código AdvPL', 'code', data.code));
    else if (block.type === 'image') { const label = document.createElement('label'); label.textContent = 'Imagem'; const select = document.createElement('select'); select.dataset.key = 'id'; select.innerHTML = '<option value="">Selecione</option>'; media.forEach(item => { const option = new Option(item.title, item.id, false, item.id === data.id); select.add(option); }); label.append(select); card.append(label); }
    else if (block.type === 'reference') { card.append(control('Referência', 'title', data.title, 'input')); card.append(control('URL', 'url', data.url, 'input')); }
    else card.append(control(block.type === 'notice' ? 'Aviso' : 'Texto', 'body', data.body));
    card.querySelectorAll('[data-key]').forEach(input => input.oninput = event => { data[event.target.dataset.key] = event.target.value; }); host.append(card);
  });
}
function move(index, direction) { const target = index + direction; if (target < 0 || target >= blocks.length) return; [blocks[index], blocks[target]] = [blocks[target], blocks[index]]; render(); }
document.querySelectorAll('[data-add]').forEach(button => button.onclick = () => { blocks.push({type: button.dataset.add, data: {}}); render(); });
document.querySelector('#editor').onsubmit = () => { document.querySelector('#blocks-json').value = JSON.stringify(blocks); };
render();
</script></body></html>
