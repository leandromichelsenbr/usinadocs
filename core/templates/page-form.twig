<!doctype html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page ? 'Editar rascunho' : 'Nova página' }}</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.block{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}.block.required{border-left:5px solid #2367a2}.tools{display:flex;gap:.5rem;flex-wrap:wrap}.hint{font-size:.9rem;color:#526174}.warning{padding:1rem;background:#fff2cc;border:1px solid #d6a800}.model-note{color:#526174}</style></head><body><main><h1>{{ page ? 'Editar rascunho ' ~ (page.language|default('pt')|upper) : 'Nova página' }}</h1>{% if missing %}<p class="warning"><strong>Publicação bloqueada.</strong> Inclua os artefatos obrigatórios: {{ missing }}.</p>{% endif %}<form id="editor" method="post" action="{{ page and page.language is defined ? '/admin/pages/' ~ page.page_id ~ '/' ~ page.language : (page ? '/admin/pages/' ~ page.page_id : '/admin/pages') }}"><label>Modelo da página <select name="content_type" id="content-type">{% for model in models %}<option value="{{ model.content_type }}" {% if page.content_type|default('reference') == model.content_type %}selected{% endif %}>{{ model.label }}</option>{% endfor %}</select></label><p class="model-note" id="model-note"></p><label>Título <input name="title" required value="{{ page.title|default('') }}"></label>{% if not page %}<label>Endereço <input name="slug" required pattern="[a-z0-9-]+"></label>{% endif %}<label>Resumo <textarea name="summary">{{ page.summary|default('') }}</textarea></label><h2>Blocos</h2><div id="blocks"></div><div class="tools" id="model-tools"></div><input type="hidden" name="blocks_json" id="blocks-json"><p><button>Salvar rascunho</button></p></form>{% if page and page.language is defined and page.language != 'pt' %}<form method="post" action="/admin/pages/{{ page.page_id }}/{{ page.language }}/publish"><button>Publicar tradução</button></form>{% endif %}<p><a href="/admin">Cancelar</a></p></main><script id="initial-blocks" type="application/json">{{ blocks|default([])|json_encode|raw }}</script><script id="available-media" type="application/json">{{ media|default([])|json_encode|raw }}</script><script id="editorial-models" type="application/json">{{ models|default([])|json_encode|raw }}</script><script>
const host=document.querySelector('#blocks'),initialBlocks=JSON.parse(document.querySelector('#initial-blocks').textContent),media=JSON.parse(document.querySelector('#available-media').textContent),models=JSON.parse(document.querySelector('#editorial-models').textContent),reusableArtifacts={{ reusable_artifacts|default([])|json_encode|raw }},typeSelect=document.querySelector('#content-type'),modelTools=document.querySelector('#model-tools');let blocks=initialBlocks;
function currentModel(){return models.find(model=>model.content_type===typeSelect.value)||{description:'',artifacts:[]}}
function refreshModel(){const model=currentModel();document.querySelector('#model-note').textContent=model.description||'';modelTools.replaceChildren();model.artifacts.forEach(artifact=>{const button=document.createElement('button');button.type='button';button.dataset.add=artifact.type;button.textContent='Adicionar '+artifact.label+(artifact.required?' · obrigatório':'');button.onclick=()=>{blocks.push({type:artifact.type,data:{}});render()};modelTools.append(button)});if(reusableArtifacts.length){const button=document.createElement('button');button.type='button';button.textContent='Inserir artefato reutilizável';button.onclick=()=>{blocks.push({type:'reusable_artifact',data:{artifact_id:reusableArtifacts[0].id}});render()};modelTools.append(button)}if(!blocks.length){const required=model.artifacts.filter(artifact=>artifact.required);blocks=(required.length?required:[model.artifacts[0]||{type:'text'}]).map(artifact=>({type:artifact.type,data:{}}))}render()}
function control(label,key,value,tag='textarea'){const wrapper=document.createElement('label');wrapper.textContent=label;const input=document.createElement(tag);input.dataset.key=key;input.value=value||'';wrapper.append(input);return wrapper}
function tableEditor(card,data){const lineBreak=String.fromCharCode(10);data.headers=Array.isArray(data.headers)?data.headers:(data.headers||'').split('|').map(value=>value.trim()).filter(Boolean);data.rows=Array.isArray(data.rows)?data.rows:(data.rows||'').split(lineBreak).filter(Boolean).map(line=>line.split('|').map(value=>value.trim()));if(!data.headers.length)data.headers=['Coluna 1','Coluna 2'];if(!data.rows.length)data.rows=[['','']];const headers=control('Cabeçalhos (separe por |)','headers',data.headers.join(' | '),'input'),rows=control('Linhas (uma por linha; células separadas por |)','rows',data.rows.map(row=>row.join(' | ')).join(lineBreak));delete headers.querySelector('input').dataset.key;delete rows.querySelector('textarea').dataset.key;const hint=document.createElement('p');hint.className='hint';hint.textContent='Exemplo: Nome | Tipo, em seguida Produto | Caracter.';headers.querySelector('input').oninput=e=>data.headers=e.target.value.split('|').map(value=>value.trim()).filter(Boolean);rows.querySelector('textarea').oninput=e=>data.rows=e.target.value.split(lineBreak).filter(Boolean).map(line=>line.split('|').map(value=>value.trim()));card.append(headers,rows,hint)}
function diagramEditor(card,data){const lineBreak=String.fromCharCode(10);data.nodes=Array.isArray(data.nodes)?data.nodes:(data.nodes||'').split(lineBreak).filter(Boolean);data.edges=Array.isArray(data.edges)?data.edges:(data.edges||'').split(lineBreak).filter(Boolean);const title=control('Título do diagrama','title',data.title,'input'),nodes=control('Nós (um por linha)','nodes',data.nodes.join(lineBreak)),edges=control('Conexões (uma por linha, use A -> B)','edges',data.edges.join(lineBreak));delete nodes.querySelector('textarea').dataset.key;delete edges.querySelector('textarea').dataset.key;const hint=document.createElement('p');hint.className='hint';hint.textContent='Exemplo de nós: Início, Validar dados, Processar. Exemplo de conexão: Início -> Validar dados.';nodes.querySelector('textarea').oninput=e=>data.nodes=e.target.value.split(lineBreak).map(value=>value.trim()).filter(Boolean);edges.querySelector('textarea').oninput=e=>data.edges=e.target.value.split(lineBreak).map(value=>value.trim()).filter(Boolean);card.append(title,nodes,edges,hint)}
function quizEditor(card,data){const lineBreak=String.fromCharCode(10);data.options=Array.isArray(data.options)?data.options:(data.options||'').split(lineBreak).filter(Boolean);if(!data.options.length)data.options=['Alternativa 1','Alternativa 2'];const options=control('Alternativas (uma por linha)','options',data.options.join(lineBreak)),correct=control('Alternativa correta (começa em 1)','correct',data.correct===undefined?'1':String(Number(data.correct)+1),'input');correct.querySelector('input').type='number';correct.querySelector('input').min='1';delete options.querySelector('textarea').dataset.key;options.querySelector('textarea').oninput=e=>data.options=e.target.value.split(lineBreak).map(value=>value.trim()).filter(Boolean);correct.querySelector('input').oninput=e=>data.correct=Math.max(0,Number(e.target.value||1)-1);card.append(control('Pergunta','question',data.question),options,correct,control('Explicação após acerto','explanation',data.explanation),control('Explicação após erro','error_explanation',data.error_explanation),control('Link de revisão após erro (opcional)','error_url',data.error_url,'input'))}
function imageEditor(card,data){const label=document.createElement('label');label.textContent='Imagem';const select=document.createElement('select');select.dataset.key='id';select.innerHTML='<option value="">Selecione</option>';media.forEach(item=>select.add(new Option(item.title,item.id,false,item.id===data.id)));label.append(select);const display=control('Exibição','display',data.display||'static','select');display.querySelector('select').append(new Option('Exibir imediatamente','static'),new Option('Exibir sob demanda','on_demand'));display.querySelector('select').value=data.display||'static';const buttonLabel=control('Texto do botão quando sob demanda','button_label',data.button_label||'Carregar imagem','input');const hint=document.createElement('p');hint.className='hint';hint.textContent='No modo sob demanda, o arquivo só será carregado quando o visitante clicar no botão. Imagens amplas são reduzidas para caber na página e podem ser clicadas para abrir no tamanho original.';card.append(label,display,buttonLabel,hint)}
function reusableArtifactEditor(card,data){const label=document.createElement('label');label.textContent='Artefato publicado';const select=document.createElement('select');reusableArtifacts.forEach(item=>select.add(new Option(item.title+' · '+item.artifact_type+' · revisão '+item.revision_number,item.id,false,item.id===data.artifact_id)));if(!data.artifact_id&&reusableArtifacts[0]){data.artifact_id=reusableArtifacts[0].id;data.artifact_revision_id=reusableArtifacts[0].revision_id}select.onchange=event=>{const selected=reusableArtifacts.find(item=>item.id===event.target.value);data.artifact_id=event.target.value;data.artifact_revision_id=selected?selected.revision_id:'';render()};label.append(select);const selected=reusableArtifacts.find(item=>item.id===data.artifact_id),hint=document.createElement('p');hint.className='hint';const pinned=data.artifact_revision_id;hint.textContent=pinned&&selected&&pinned!==selected.revision_id?'Esta página usa uma revisão anterior do artefato.':'A revisão publicada atual será fixada quando a página for publicada.';card.append(label,hint);if(pinned&&selected&&pinned!==selected.revision_id){const update=document.createElement('button');update.type='button';update.textContent='Atualizar para a revisão '+selected.revision_number;update.onclick=()=>{data.artifact_revision_id=selected.revision_id;render()};card.append(update)}}
function render(){host.replaceChildren();const model=currentModel();blocks.forEach((block,index)=>{const definition=model.artifacts.find(artifact=>artifact.type===block.type);const card=document.createElement('section');card.className='block'+(definition&&definition.required?' required':'');const tools=document.createElement('div');tools.className='tools';tools.innerHTML='<strong>'+(block.type==='reusable_artifact'?'Artefato reutilizável':(definition?definition.label:block.type))+(definition&&definition.required?' · obrigatório':'')+'</strong>';[['↑',()=>move(index,-1)],['↓',()=>move(index,1)],['Remover',()=>{blocks.splice(index,1);render()}]].forEach(([label,action])=>{const button=document.createElement('button');button.type='button';button.textContent=label;button.onclick=action;tools.append(button)});card.append(tools);const data=block.data||(block.data={});if(block.type==='reusable_artifact')reusableArtifactEditor(card,data);else if(block.type==='heading')card.append(control('Título da seção','text',data.text,'input'));else if(block.type==='code')card.append(control('Código AdvPL','code',data.code));else if(block.type==='signature')card.append(control('Sintaxe AdvPL','syntax',data.syntax));else if(block.type==='table')tableEditor(card,data);else if(block.type==='diagram')diagramEditor(card,data);else if(block.type==='quiz')quizEditor(card,data);else if(block.type==='citation'){card.append(control('Trecho citado','text',data.text),control('Autor','author',data.author,'input'),control('Ano','year',data.year,'input'),control('Obra ou fonte','work',data.work,'input'),control('Página (opcional)','page',data.page,'input'),control('URL (opcional)','url',data.url,'input'))}else if(block.type==='image')imageEditor(card,data);else if(block.type==='reference'){card.append(control('Referência','title',data.title,'input'),control('URL','url',data.url,'input'))}else card.append(control(block.type==='notice'?'Aviso':'Texto','body',data.body));card.querySelectorAll('[data-key]').forEach(input=>input.oninput=event=>{data[event.target.dataset.key]=event.target.value});host.append(card)})}
function move(index,direction){const target=index+direction;if(target<0||target>=blocks.length)return;[blocks[index],blocks[target]]=[blocks[target],blocks[index]];render()}typeSelect.onchange=refreshModel;document.querySelector('#editor').onsubmit=()=>{document.querySelector('#blocks-json').value=JSON.stringify(blocks)};refreshModel();
</script>{% if page %}<form method="post" action="/admin/pages/{{ page.page_id }}/revisions/{{ page.language|default('pt') }}/discard" onsubmit="return confirm('Excluir este rascunho? A versão publicada, se existir, será preservada.')"><button type="submit">Excluir revisão</button></form>{% endif %}</body></html>
