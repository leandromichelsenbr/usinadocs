{% set labels = editorial_labels[reader_preferences.language] %}
{% set fields = editor_form_labels[reader_preferences.language] %}
{% set locale = reader_preferences.language %}
{% set edition = page.language|default('pt') %}
{% set content_type = submitted.content_type|default(page.content_type|default('reference')) %}
{% set preference_query = missing ? {missing: missing} : {} %}
{% if section_error %}{% set preference_query = preference_query|merge({section_error: '1'}) %}{% endif %}
{# An inline validation response is on the save URL. Point preference links back to the GET editor.
   A resposta de validação está no endereço de gravação. Os links de preferência voltam à rota GET do editor. #}
{% set preference_path = submitted ? (page ? '/admin/pages/' ~ page.page_id ~ (page.language is defined ? '/' ~ edition : '') ~ '/edit' : '/admin/pages/new') : '' %}
{% set heading = page ? labels.edit_draft ~ ' ' ~ edition|upper : fields.new %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ heading }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
        main { max-width: 60rem; margin-block: 2rem; }
        label, input, textarea, select { display: block; box-sizing: border-box; width: 100%; margin: .4rem 0; }
        textarea { min-height: 7rem; }
        .block { border: 1px solid light-dark(#ccd4e0, #53685b); padding: 1rem; margin: 1rem 0; }
        .block.required { border-left: 5px solid light-dark(#2367a2, #7fc7ff); }
        .tools, .editor-actions { display: flex; gap: .65rem; align-items: center; flex-wrap: wrap; }
        .hint, .model-note { font-size: .9rem; color: light-dark(#526174, #bfccdc); }
        .warning { padding: 1rem; background: light-dark(#fff2cc, #3b2e15); border: 1px solid light-dark(#b08700, #ba9f43); }
        [hidden] { display: none; }
    </style>
</head>
<body><main class="reader-screen">
    <a href="/admin">{{ reader_preferences.text.panel }}</a>
    {# Preference links stay on the same draft edition, including when the interface language changes.
       Os links de preferência mantêm a mesma edição do rascunho, mesmo ao mudar o idioma da interface. #}
    {% include 'reader-language.twig' with {query: preference_query, preference_path: preference_path} only %}
    <h1>{{ heading }}</h1>
    {% if missing %}<p class="warning"><strong>{{ fields.publication_blocked }}</strong> {{ fields.required_artifacts }}: {{ missing }}.</p>{% endif %}
    {% if submitted.tags_error %}<p class="warning" role="alert">{{ fields.article_tags_error }}</p>{% endif %}
    {% if section_error %}<p class="warning" role="alert">{{ fields.unavailable_section }}</p>{% endif %}
    <form id="editor" method="post" data-warn-unsaved="{{ submitted ? 'dirty' : '' }}" action="{{ page and page.language is defined ? '/admin/pages/' ~ page.page_id ~ '/' ~ page.language : (page ? '/admin/pages/' ~ page.page_id : '/admin/pages') }}"><input type="hidden" name="csrf" value="{{ csrf_token() }}">
        <label>{{ fields.model }} <select name="content_type" id="content-type">
            {% for model in models %}<option value="{{ model.content_type }}"{% if content_type == model.content_type %} selected{% endif %}>{{ model.label }}</option>{% endfor %}
        </select></label>
        <p class="model-note" id="model-note"></p>
        <label id="article-section"{% if content_type != 'article' %} hidden{% endif %}>
            {{ fields.section }}
            <select name="article_section"{% if content_type != 'article' %} disabled{% endif %}>
                <option value="">{{ fields.no_section }}</option>
                {% for section in sections %}
                    <option value="{{ section.slug }}"{% if section.slug == selected_section %} selected{% endif %}>{{ section['title_' ~ locale] }}{% if section.blocked %} ({{ fields.section_blocked }}){% endif %}</option>
                {% endfor %}
            </select>
        </label>
        {# The original edition owns hashtag changes, which are published with its body and title.
           A edição original controla as alterações de hashtags, publicadas junto com o corpo e o título. #}
        {% if news_hashtags and edition == 'pt' %}
            <label id="article-tags-editor"{% if content_type != 'article' %} hidden{% endif %}>
                {{ fields.article_tags }}
                <input name="article_tags" value="{{ tag_input }}" aria-describedby="article-tags-hint"{% if content_type != 'article' %} disabled{% endif %}>
                <small id="article-tags-hint" class="hint">{{ fields.article_tags_hint }}</small>
            </label>
        {% endif %}
        <label>{{ labels.title }} <input name="title" required value="{{ submitted.title ?? page.title|default('') }}"></label>
        {% if not page %}<label>{{ fields.address }} <input name="slug" value="{{ submitted.slug|default('') }}" required pattern="[a-z0-9-]+"></label>{% endif %}
        <label>{{ fields.summary }} <textarea name="summary">{{ submitted.summary ?? page.summary|default('') }}</textarea></label>
        <h2>{{ labels.blocks }}</h2>
        <div id="blocks" data-editor-changes></div><div class="tools" id="model-tools" data-editor-changes></div>
        <input type="hidden" name="blocks_json" id="blocks-json">
        <p><button type="submit">{{ fields.save_draft }}</button></p>
    </form>
    <div class="editor-actions">
        {% if page and page.language is defined and page.language != 'pt' %}
            <form method="post" action="/admin/pages/{{ page.page_id }}/{{ page.language }}/publish"><input type="hidden" name="csrf" value="{{ csrf_token() }}"><button type="submit">{{ fields.publish_translation }}</button></form>
        {% endif %}
        {% if page %}<a href="/admin/pages/{{ page.page_id }}/revisions/{{ edition }}/discard">{{ labels.discard }}</a>{% endif %}
        <a href="/admin">{{ labels.cancel }}</a>
    </div>
</main>
<script id="initial-blocks" type="application/json">{{ blocks|default([])|json_encode|raw }}</script><script id="available-media" type="application/json">{{ media|default([])|json_encode|raw }}</script><script id="editorial-models" type="application/json">{{ models|default([])|json_encode|raw }}</script><script id="editor-control-copy" type="application/json">{{ fields|json_encode|raw }}</script>
<script>
// Read localized controls as data so content and editorial metadata retain their own language.
// Lê os controles localizados como dados e preserva o idioma do conteúdo e dos metadados editoriais.
const editorCopy = JSON.parse(document.querySelector('#editor-control-copy').textContent);
const sectionInput = document.querySelector('#article-section');
const host=document.querySelector('#blocks'),initialBlocks=JSON.parse(document.querySelector('#initial-blocks').textContent),media=JSON.parse(document.querySelector('#available-media').textContent),models=JSON.parse(document.querySelector('#editorial-models').textContent),reusableArtifacts={{ reusable_artifacts|default([])|json_encode|raw }},typeSelect=document.querySelector('#content-type'),modelTools=document.querySelector('#model-tools');let blocks=initialBlocks;
function currentModel(){return models.find(model=>model.content_type===typeSelect.value)||{description:'',artifacts:[]}}
// Offer YouTube in article drafts without modifying the published editorial model history.
// Oferece YouTube nos rascunhos de artigos sem alterar o histórico publicado dos modelos editoriais.
function refreshModel(){
    // Section classification belongs to articles and uses the current draft type.
    // A classificação por editoria pertence aos artigos e usa o tipo atual do rascunho.
    const isArticle = typeSelect.value === 'article';
    sectionInput.hidden = !isArticle;
    sectionInput.querySelector('select').disabled = !isArticle;
    // Tag editing follows the same model selector and is available only in the original edition.
    // A edição das hashtags acompanha o seletor de modelo e só está disponível na edição original.
    const tagsInput = document.querySelector('#article-tags-editor');
    if (tagsInput) {
        tagsInput.hidden = !isArticle;
        tagsInput.querySelector('input').disabled = !isArticle;
    }
    const model=currentModel();document.querySelector('#model-note').textContent=model.description||'';modelTools.replaceChildren();model.artifacts.forEach(artifact=>{const button=document.createElement('button');button.type='button';button.dataset.add=artifact.type;button.textContent=editorCopy.add+' '+artifact.label+(artifact.required?' · '+editorCopy.required:'');button.onclick=()=>{blocks.push({type:artifact.type,data:{}});render()};modelTools.append(button)});if(typeSelect.value==='article'){const video=document.createElement('button');video.type='button';video.dataset.add='youtube';video.textContent=editorCopy.add_youtube;video.onclick=()=>{blocks.push({type:'youtube',data:{}});render()};modelTools.append(video)}if(reusableArtifacts.length){const button=document.createElement('button');button.type='button';button.textContent=editorCopy.insert_artifact;button.onclick=()=>{blocks.push({type:'reusable_artifact',data:{artifact_id:reusableArtifacts[0].id}});render()};modelTools.append(button)}if(!blocks.length){const required=model.artifacts.filter(artifact=>artifact.required);blocks=(required.length?required:[model.artifacts[0]||{type:'text'}]).map(artifact=>({type:artifact.type,data:{}}))}render()}
function control(label,key,value,tag='textarea'){const wrapper=document.createElement('label');wrapper.textContent=label;const input=document.createElement(tag);input.dataset.key=key;input.value=value||'';wrapper.append(input);return wrapper}
function tableEditor(card,data){const lineBreak=String.fromCharCode(10);data.headers=Array.isArray(data.headers)?data.headers:(data.headers||'').split('|').map(value=>value.trim()).filter(Boolean);data.rows=Array.isArray(data.rows)?data.rows:(data.rows||'').split(lineBreak).filter(Boolean).map(line=>line.split('|').map(value=>value.trim()));if(!data.headers.length)data.headers=[editorCopy.column+' 1',editorCopy.column+' 2'];if(!data.rows.length)data.rows=[['','']];const headers=control(editorCopy.table_headers,'headers',data.headers.join(' | '),'input'),rows=control(editorCopy.table_rows,'rows',data.rows.map(row=>row.join(' | ')).join(lineBreak));delete headers.querySelector('input').dataset.key;delete rows.querySelector('textarea').dataset.key;const hint=document.createElement('p');hint.className='hint';hint.textContent=editorCopy.table_example;headers.querySelector('input').oninput=e=>data.headers=e.target.value.split('|').map(value=>value.trim()).filter(Boolean);rows.querySelector('textarea').oninput=e=>data.rows=e.target.value.split(lineBreak).filter(Boolean).map(line=>line.split('|').map(value=>value.trim()));card.append(headers,rows,hint)}
function diagramEditor(card,data){const lineBreak=String.fromCharCode(10);data.nodes=Array.isArray(data.nodes)?data.nodes:(data.nodes||'').split(lineBreak).filter(Boolean);data.edges=Array.isArray(data.edges)?data.edges:(data.edges||'').split(lineBreak).filter(Boolean);const title=control(editorCopy.diagram_title,'title',data.title,'input'),nodes=control(editorCopy.nodes,'nodes',data.nodes.join(lineBreak)),edges=control(editorCopy.edges,'edges',data.edges.join(lineBreak));delete nodes.querySelector('textarea').dataset.key;delete edges.querySelector('textarea').dataset.key;const hint=document.createElement('p');hint.className='hint';hint.textContent=editorCopy.diagram_example;nodes.querySelector('textarea').oninput=e=>data.nodes=e.target.value.split(lineBreak).map(value=>value.trim()).filter(Boolean);edges.querySelector('textarea').oninput=e=>data.edges=e.target.value.split(lineBreak).map(value=>value.trim()).filter(Boolean);card.append(title,nodes,edges,hint)}
function quizEditor(card,data){const lineBreak=String.fromCharCode(10);data.options=Array.isArray(data.options)?data.options:(data.options||'').split(lineBreak).filter(Boolean);if(!data.options.length)data.options=[editorCopy.option+' 1',editorCopy.option+' 2'];const options=control(editorCopy.options,'options',data.options.join(lineBreak)),correct=control(editorCopy.correct_option,'correct',data.correct===undefined?'1':String(Number(data.correct)+1),'input');correct.querySelector('input').type='number';correct.querySelector('input').min='1';delete options.querySelector('textarea').dataset.key;options.querySelector('textarea').oninput=e=>data.options=e.target.value.split(lineBreak).map(value=>value.trim()).filter(Boolean);correct.querySelector('input').oninput=e=>data.correct=Math.max(0,Number(e.target.value||1)-1);card.append(control(editorCopy.question,'question',data.question),options,correct,control(editorCopy.right_explanation,'explanation',data.explanation),control(editorCopy.wrong_explanation,'error_explanation',data.error_explanation),control(editorCopy.review_link,'error_url',data.error_url,'input'))}
function imageEditor(card,data){const label=document.createElement('label');label.textContent=editorCopy.image;const select=document.createElement('select');select.dataset.key='id';select.append(new Option(editorCopy.select,''));media.forEach(item=>select.add(new Option(item.title,item.id,false,item.id===data.id)));label.append(select);const display=control(editorCopy.display,'display',data.display||'static','select');display.querySelector('select').append(new Option(editorCopy.immediate,'static'),new Option(editorCopy.on_demand,'on_demand'));display.querySelector('select').value=data.display||'static';const buttonLabel=control(editorCopy.button_text,'button_label',data.button_label||editorCopy.load_image,'input');const hint=document.createElement('p');hint.className='hint';hint.textContent=editorCopy.image_hint;card.append(label,display,buttonLabel,hint)}
function reusableArtifactEditor(card,data){const label=document.createElement('label');label.textContent=editorCopy.published_artifact;const select=document.createElement('select');reusableArtifacts.forEach(item=>select.add(new Option(item.title+' · '+item.artifact_type+' · '+editorCopy.revision+' '+item.revision_number,item.id,false,item.id===data.artifact_id)));if(!data.artifact_id&&reusableArtifacts[0]){data.artifact_id=reusableArtifacts[0].id;data.artifact_revision_id=reusableArtifacts[0].revision_id}select.onchange=event=>{const selected=reusableArtifacts.find(item=>item.id===event.target.value);data.artifact_id=event.target.value;data.artifact_revision_id=selected?selected.revision_id:'';render()};label.append(select);const selected=reusableArtifacts.find(item=>item.id===data.artifact_id),hint=document.createElement('p');hint.className='hint';const pinned=data.artifact_revision_id;hint.textContent=pinned&&selected&&pinned!==selected.revision_id?editorCopy.older_artifact:editorCopy.pin_artifact;card.append(label,hint);if(pinned&&selected&&pinned!==selected.revision_id){const update=document.createElement('button');update.type='button';update.textContent=editorCopy.update_artifact+' '+selected.revision_number;update.onclick=()=>{data.artifact_revision_id=selected.revision_id;render()};card.append(update)}}
{% include 'reference-fields-js.twig' %}
function referenceEditor(card, data) {
    for (const [label, key, type] of referenceFields) {
        const field = control(label, key, data[key], 'input');
        field.querySelector('input').type = type;
        card.append(field);
    }
}
function render(){host.replaceChildren();const model=currentModel();blocks.forEach((block,index)=>{const definition=model.artifacts.find(artifact=>artifact.type===block.type);const card=document.createElement('section');card.className='block'+(definition&&definition.required?' required':'');const tools=document.createElement('div');tools.className='tools';const kind=document.createElement('strong');kind.textContent=(block.type==='reusable_artifact'?editorCopy.reusable:(definition?definition.label:block.type))+(definition&&definition.required?' · '+editorCopy.required:'');tools.append(kind);[['↑',()=>move(index,-1)],['↓',()=>move(index,1)],[editorCopy.remove,()=>{blocks.splice(index,1);render()}]].forEach(([label,action])=>{const button=document.createElement('button');button.type='button';button.textContent=label;button.onclick=action;tools.append(button)});card.append(tools);const data=block.data||(block.data={});if(block.type==='reusable_artifact')reusableArtifactEditor(card,data);else if(block.type==='heading')card.append(control(editorCopy.section_title,'text',data.text,'input'));else if(block.type==='code')card.append(control(editorCopy.code,'code',data.code));else if(block.type==='table')tableEditor(card,data);else if(block.type==='diagram')diagramEditor(card,data);else if(block.type==='quiz')quizEditor(card,data);else if(block.type==='citation'){card.append(control(editorCopy.quotation,'text',data.text),control(editorCopy.author,'author',data.author,'input'),control(editorCopy.year,'year',data.year,'input'),control(editorCopy.work,'work',data.work,'input'),control(editorCopy.optional_page,'page',data.page,'input'),control(editorCopy.optional_url,'url',data.url,'input'))}else if(block.type==='image'){imageEditor(card,data);card.append(control(editorCopy.alt,'alt',data.alt,'input'),control(editorCopy.caption,'caption',data.caption,'input'))}else if(block.type==='youtube'){card.append(control(editorCopy.youtube_url,'url',data.url,'input'),control(editorCopy.video_title,'title',data.title,'input'),control(editorCopy.caption,'caption',data.caption,'input'))}else if(block.type==='reference')referenceEditor(card,data);else card.append(control(block.type==='notice'?editorCopy.notice:editorCopy.text,'body',data.body));card.querySelectorAll('[data-key]').forEach(input=>input.oninput=event=>{data[event.target.dataset.key]=event.target.value});host.append(card)})}
function move(index,direction){const target=index+direction;if(target<0||target>=blocks.length)return;[blocks[index],blocks[target]]=[blocks[target],blocks[index]];render()}typeSelect.onchange=refreshModel;document.querySelector('#editor').onsubmit=()=>{document.querySelector('#blocks-json').value=JSON.stringify(blocks)};refreshModel();
</script>
{% include 'reader-theme.twig' with {query: preference_query, preference_path: preference_path} only %}
{% include 'editor-unsaved.twig' only %}
</body></html>
