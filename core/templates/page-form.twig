<!doctype html><html lang="pt"><meta charset="utf-8"><title>{{ page ? 'Editar rascunho' : 'Nova página' }}</title><body><main><h1>{{ page ? 'Editar rascunho ' ~ (page.language|default('pt')|upper) : 'Nova página' }}</h1><form method="post" action="{{ page and page.language is defined ? '/admin/pages/' ~ page.page_id ~ '/' ~ page.language : (page ? '/admin/pages/' ~ page.page_id : '/admin/pages') }}"><label>Título <input name="title" required value="{{ page.title|default('') }}"></label>{% if not page %}<label>Endereço <input name="slug" required pattern="[a-z0-9-]+"></label>{% endif %}<label>Resumo <textarea name="summary">{{ page.summary|default('') }}</textarea></label><label>Texto <textarea name="body" required>{{ page.body|default('') }}</textarea></label><label>Exemplo AdvPL <textarea name="code">{{ page.code|default('') }}</textarea></label><button>Salvar rascunho</button></form>{% if page and page.language is defined and page.language != 'pt' %}<form method="post" action="/admin/pages/{{ page.page_id }}/{{ page.language }}/publish"><button>Publicar tradução</button></form>{% endif %}<p><a href="/admin">Cancelar</a></p></main></body></html>
