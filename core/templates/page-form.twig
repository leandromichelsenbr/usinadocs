<!doctype html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page ? 'Editar rascunho' : 'Nova página' }}</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.block{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}.tools{display:flex;gap:.5rem;flex-wrap:wrap}.hint{font-size:.9rem;color:#526174}</style></head><body><main><h1>{{ page ? 'Editar rascunho ' ~ (page.language|default('pt')|upper) : 'Nova página' }}</h1><form id="editor" method="post" action="{{ page and page.language is defined ? '/admin/pages/' ~ page.page_id ~ '/' ~ page.language : (page ? '/admin/pages/' ~ page.page_id : '/admin/pages') }}"><label>Tipo de página <select name="content_type">{% for value,label in {reference:'Referência técnica',article:'Artigo',lesson:'Aula',class:'Classe',entry_point:'Ponto de entrada'} %}<option value="{{ value }}" {% if page.content_type|default('reference') == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label>Título <input name="title" required value="{{ page.title|default('') }}"></label>{% if not page %}<label>Endereço <input name="slug" required pattern="[a-z0-9-]+"></label>{% endif %}<label>Resumo <textarea name="summary">{{ page.summary|default('') }}</textarea></label><h2>Blocos</h2><div id="blocks"></div><div class="tools">{% for type,label in {heading:'Título de seção',text:'Texto',code:'Código',table:'Tabela',image:'Imagem',reference:'Referência',notice:'Aviso'} %}<button type="button" data-add="{{ type }}">Adicionar {{ label }}</button>{% endfor %}</div><input type="hidden" name="blocks_json" id="blocks-json"><p><button>Salvar rascunho</button></p></form>{% if page and page.language is defined and page.language != 'pt' %}<form method="post" action="/admin/pages/{{ page.page_id }}/{{ page.language }}/publish"><button>Publicar tradução</button></form>{% endif %}<p><a href="/admin">Cancelar</a></p></main><script id="initial-blocks" type="application/json">{{ blocks|default([])|json_encode|raw }}</script><script id="available-media" type="application/json">{{ media|default([])|json_encode|raw }}</script><script>
const host=document.querySelector('#blocks'),initialBlocks=JSON.parse(document.querySelector('#initial-blocks').textContent),media=JSON.parse(document.querySelector('#available-media').textContent);let blocks=initialBlocks.length?initialBlocks:[{type:'text',data:{body:''}}];
function control(label,key,value,tag='textarea'){const wrapper=document.createElement('label');wrapper.textContent=label;const input=document.createElement(tag);input.dataset.key=key;input.value=value||'';wrapper.append(input);return wrapper}
function tableEditor(card,data){const lineBreak=String.fromCharCode(10);data.headers=Array.isArray(data.headers)?data.headers:(data.headers||'').split('|').map(value=>value.trim()).filter(Boolean);data.rows=Array.isArray(data.rows)?data.rows:(data.rows||'').split(lineBreak).filter(Boolean).map(line=>line.split('|').map(value=>value.trim()));if(!data.headers.length)data.headers=['Coluna 1','Coluna 2'];if(!data.rows.length)data.rows=[['','']];const headers=control('Cabeçalhos (separe por |)','headers',data.headers.join(' | '),'input'),rows=control('Linhas (uma por linha; células separadas por |)','rows',data.rows.map(row=>row.join(' | ')).join(lineBreak));delete headers.querySelector('input').dataset.key;delete rows.querySelector('textarea').dataset.key;const hint=document.createElement('p');hint.className='hint';hint.textContent='Exemplo: Nome | Tipo, em seguida Produto | Caracter.';headers.querySelector('input').oninput=e=>data.headers=e.target.value.split('|').map(value=>value.trim()).filter(Boolean);rows.querySelector('textarea').oninput=e=>data.rows=e.target.value.split(lineBreak).filter(Boolean).map(line=>line.split('|').map(value=>value.trim()));card.append(headers,rows,hint)}
function render(){host.replaceChildren();blocks.forEach((block,index)=>{const card=document.createElement('section');card.className='block';const tools=document.createElement('div');tools.className='tools';tools.innerHTML='<strong>'+block.type+'</strong>';[['↑',()=>move(index,-1)],['↓',()=>move(index,1)],['Remover',()=>{blocks.splice(index,1);render()}]].forEach(([label,action])=>{const button=document.createElement('button');button.type='button';button.textContent=label;button.onclick=action;tools.append(button)});card.append(tools);const data=block.data||(block.data={});if(block.type==='heading')card.append(control('Título da seção','text',data.text,'input'));else if(block.type==='code')card.append(control('Código AdvPL','code',data.code));else if(block.type==='table')tableEditor(card,data);else if(block.type==='image'){const label=document.createElement('label');label.textContent='Imagem';const select=document.createElement('select');select.dataset.key='id';select.innerHTML='<option value="">Selecione</option>';media.forEach(item=>select.add(new Option(item.title,item.id,false,item.id===data.id)));label.append(select);card.append(label)}else if(block.type==='reference'){card.append(control('Referência','title',data.title,'input'),control('URL','url',data.url,'input'))}else card.append(control(block.type==='notice'?'Aviso':'Texto','body',data.body));card.querySelectorAll('[data-key]').forEach(input=>input.oninput=event=>{data[event.target.dataset.key]=event.target.value});host.append(card)})}
function move(index,direction){const target=index+direction;if(target<0||target>=blocks.length)return;[blocks[index],blocks[target]]=[blocks[target],blocks[index]];render()}document.querySelectorAll('[data-add]').forEach(button=>button.onclick=()=>{blocks.push({type:button.dataset.add,data:{}});render()});document.querySelector('#editor').onsubmit=()=>{document.querySelector('#blocks-json').value=JSON.stringify(blocks)};render();
</script></body></html>
