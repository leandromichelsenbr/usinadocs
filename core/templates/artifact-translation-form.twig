<!doctype html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Traduzir artefato · Usina Docs</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.editor{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}</style></head><body><main><p><a href="/admin/artifacts">← Artefatos reutilizáveis</a></p><p>Editor de conteúdo · <strong>Artefato · {{ artifact.language|upper }}</strong></p><h1>Traduzir {{ artifact.title }}</h1><form id="artifact-editor" method="post" action="/admin/artifacts/{{ artifact.id }}/{{ artifact.language }}"><label>Tipo <input value="{{ artifact.artifact_type }}" disabled></label><label>Nome <input name="title" required value="{{ artifact.title }}"></label><label>Descrição <textarea name="description">{{ artifact.description }}</textarea></label><h2>Conteúdo</h2><section class="editor" id="fields"></section><input type="hidden" name="data_json" id="data-json"><p><button>Salvar tradução</button></p></form><form method="post" action="/admin/artifacts/{{ artifact.id }}/{{ artifact.language }}/publish"><button>Publicar tradução</button></form></main><script id="initial-data" type="application/json">{{ data|json_encode|raw }}</script><script>
let data=JSON.parse(document.querySelector('#initial-data').textContent),type='{{ artifact.artifact_type }}',host=document.querySelector('#fields');function field(label,key,tag='textarea'){const wrapper=document.createElement('label');wrapper.textContent=label;const input=document.createElement(tag);input.value=data[key]||'';input.oninput=event=>data[key]=event.target.value;wrapper.append(input);host.append(wrapper)}function render(){if(type==='heading')field('Título','text','input');else if(type==='code'){field('Linguagem','language','input');field('Código','code')}else if(type==='reference'){field('Referência','title','input');field('URL','url','input')}else if(type==='citation'){field('Trecho citado','text');field('Autor','author','input');field('Obra ou fonte','work','input');field('URL','url','input')}else if(type==='image'){field('Identificador da mídia','id','input');field('Legenda','caption','input')}else if(type==='quiz'){field('Pergunta','question');field('Alternativas, uma por linha','options_text');field('Resposta correta','correct','input');field('Explicação','explanation')}else if(type==='table'){field('Cabeçalhos separados por |','headers_text','input');field('Linhas, uma por linha e células separadas por |','rows_text')}else if(type==='diagram'){field('Título','title','input');field('Nós, um por linha','nodes_text');field('Conexões, uma por linha','edges_text')}else field(type==='notice'?'Aviso':'Texto','body')}document.querySelector('#artifact-editor').onsubmit=()=>document.querySelector('#data-json').value=JSON.stringify(data);render();
</script></body></html>
