{% set labels = editorial_labels[reader_preferences.language] %}
{% set path = '/admin/pages/' ~ page_id %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ labels.revision_history }} · Usina Docs</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
        main { max-width: 68rem; margin-block: 2rem; }
        .history { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th,td { padding: .75rem; border-bottom: 1px solid light-dark(#becabe, #53685b); text-align: left; }
        .current { font-weight: 700; }
        td form { display: inline-block; margin: .15rem 0; }
    </style>
</head>
<body><main class="reader-screen">
    <p><a href="/admin">← {{ reader_preferences.text.panel }}</a></p>
    {% include 'reader-language.twig' with {query: show_archived ? {archived: '1'} : {}} only %}
    <h1>{{ labels.revision_history }} · {{ language|upper }}</h1>
    <p>{{ labels.restore_note }}</p>
    {% if history|filter(revision => revision.archived) %}
        <p><a href="{{ path }}/history/{{ language }}{{ show_archived ? '' : '?archived=1' }}">{{ show_archived ? labels.hide_archived : labels.show_archived }}</a></p>
    {% endif %}
    <div class="history"><table>
        <thead><tr>{% for field in ['revision', 'title', 'state', 'blocks', 'date', 'actions'] %}<th scope="col">{{ labels[field] }}</th>{% endfor %}</tr></thead>
        <tbody>
        {# Archived snapshots stay in storage but only appear here when the editor requests them.
           As revisões arquivadas ficam gravadas e só aparecem aqui quando o editor solicita. #}
        {% for revision in history|filter(revision => show_archived or not revision.archived) %}
            <tr>
                <td>{{ revision.number }}</td><td>{{ revision.title }}</td>
                <td class="{{ revision.is_current ? 'current' : '' }}">{{ labels[revision.is_current ? 'current' : (revision.archived ? 'archived' : (revision.status == 'published' ? 'previous' : revision.status))] }}</td>
                <td>{{ revision.block_count }}</td><td>{{ revision.published_at|default(revision.created_at) }}</td>
                <td>
                    {% if current and revision.id != current.id %}
                        <a href="{{ path }}/compare/{{ language }}?from={{ revision.id }}&amp;to={{ current.id }}">{{ labels.compare }}</a>
                    {% endif %}
                    {% if revision.status == 'draft' %}
                        <a href="{{ path }}/revisions/{{ language }}/discard">{{ labels.discard }}</a>
                    {% elseif revision.status == 'published' and not revision.is_current %}
                        {% if not revision.archived %}
                            <form method="post" action="{{ path }}/restore/{{ language }}/{{ revision.id }}"><input type="hidden" name="csrf" value="{{ csrf_token() }}"><button>{{ labels.restore }}</button></form>
                        {% endif %}
                        <form method="post" action="{{ path }}/revisions/{{ language }}/{{ revision.id }}/archive">
                            <input type="hidden" name="csrf" value="{{ csrf_token() }}">
                            <button type="submit" name="archived" value="{{ revision.archived ? '0' : '1' }}">{{ revision.archived ? labels.unarchive : labels.archive }}</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
</main>
{% include 'reader-theme.twig' with {query: show_archived ? {archived: '1'} : {}} only %}
</body></html>
