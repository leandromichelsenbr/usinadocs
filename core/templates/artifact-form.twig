<!doctype html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ artifact ? 'Editar artefato' : 'Novo artefato' }} · Usina Docs</title><style>body{font:16px system-ui;max-width:900px;margin:2rem}label,input,textarea,select{display:block;width:100%;margin:.4rem 0}textarea{min-height:7rem}.editor{border:1px solid #ccd4e0;padding:1rem;margin:1rem 0}.hint{color:#526174;font-size:.9rem}</style></head><body><main><p><a href="/admin/artifacts">← Artefatos reutilizáveis</a></p><p>Editor de conteúdo · <strong>Artefato</strong></p><h1>{{ artifact ? 'Editar artefato' : 'Novo artefato' }}</h1><form id="artifact-editor" method="post" action="{{ artifact ? '/admin/artifacts/' ~ artifact.id : '/admin/artifacts' }}"><label>Categoria <select disabled><option>Artefato</option></select></label><label>Tipo <select name="artifact_type" id="artifact-type" {% if artifact %}disabled{% endif %}>{% for value,label in {heading:'Título de seção',text:'Texto',code:'Código',table:'Tabela',diagram:'Diagrama',quiz:'Quiz',image:'Imagem',reference:'Referência',citation:'Citação',notice:'Aviso'} %}<option value="{{ value }}" {% if artifact.artifact_type|default('text') == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% if artifact %}<input type="hidden" name="artifact_type" value="{{ artifact.artifact_type }}">{% endif %}<label>Identificador <input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ artifact.slug|default('') }}" {% if artifact %}readonly{% endif %}></label><label>Nome <input name="title" required value="{{ artifact.title|default('') }}"></label><label>Descrição <textarea name="description">{{ artifact.description|default('') }}</textarea></label><h2>Conteúdo</h2><section class="editor" id="fields"></section><input type="hidden" name="data_json" id="data-json"><p><button>Salvar rascunho</button></p></form>{% if artifact %}<form method="post" action="/admin/artifacts/{{ artifact.id }}/publish"><button>Publicar artefato</button></form>{% endif %}</main><script id="initial-data" type="application/json">{{ data|default({})|json_encode|raw }}</script><script>
let data=JSON.parse(document.querySelector('#initial-data').textContent),type=document.querySelector('#artifact-type'),host=document.querySelector('#fields');function field(label,key,tag='textarea'){const wrapper=document.createElement('label');wrapper.textContent=label;const input=document.createElement(tag);input.value=data[key]||'';input.oninput=event=>data[key]=event.target.value;wrapper.append(input);host.append(wrapper)}function render(){host.replaceChildren();const selected=type.value;if(selected==='heading')field('Título','text','input');else if(selected==='code'){field('Linguagem','language','input');field('Código','code')}else if(selected==='reference'){field('Referência','title','input');field('URL','url','input')}else if(selected==='citation'){field('Trecho citado','text');field('Autor','author','input');field('Obra ou fonte','work','input');field('URL','url','input')}else if(selected==='image'){field('Identificador da mídia','id','input');field('Legenda','caption','input')}else if(selected==='quiz'){field('Pergunta','question');field('Alternativas, uma por linha','options_text');field('Resposta correta','correct','input');field('Explicação','explanation')}else if(selected==='table'){field('Cabeçalhos separados por |','headers_text','input');field('Linhas, uma por linha e células separadas por |','rows_text')}else if(selected==='diagram'){field('Título','title','input');field('Nós, um por linha','nodes_text');field('Conexões, uma por linha','edges_text')}else field(selected==='notice'?'Aviso':'Texto','body')}type.onchange=()=>{data={};render()};document.querySelector('#artifact-editor').onsubmit=()=>document.querySelector('#data-json').value=JSON.stringify(data);render();
</script></body></html>
