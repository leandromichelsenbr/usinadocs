<!doctype html><html lang="pt"><meta charset="utf-8"><title>Histórico do modelo · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1000px}table{width:100%;border-collapse:collapse}th,td{padding:.75rem;border-bottom:1px solid #ddd;text-align:left}.current{color:#096b2e;font-weight:700}form{display:inline}</style><body><main><p><a href="/admin/models">← Modelos editoriais</a></p><h1>Histórico do modelo</h1><p>Restaurar cria um novo rascunho sem alterar revisões existentes.</p><table><thead><tr><th>Revisão</th><th>Nome</th><th>Estado</th><th>Estrutura</th><th>Ações</th></tr></thead><tbody>{% for revision in history %}<tr><td>{{ revision.number }}</td><td>{{ revision.label }}</td><td class="{{ revision.is_current ? 'current' : '' }}">{{ revision.is_current ? 'publicada atual' : (revision.status == 'draft' ? 'rascunho' : 'publicada anteriormente') }}</td><td>{{ revision.artifacts|length }} artefatos</td><td>{% if current and revision.id != current.id %}<a href="/admin/models/{{ model_id }}/compare?from={{ revision.id }}&to={{ current.id }}">Comparar com a atual</a> · {% endif %}{% if revision.status == 'published' and not revision.is_current %}<form method="post" action="/admin/models/{{ model_id }}/restore/{{ revision.id }}"><button>Restaurar como rascunho</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></main></body></html>
