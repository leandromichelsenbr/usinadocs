<!doctype html><html lang="pt"><meta charset="utf-8"><title>Comparar artefato · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1100px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.card{border:1px solid #ccd4e0;padding:1rem}pre{white-space:pre-wrap}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style><body><main><p><a href="/admin/artifacts/{{ artifact_id }}/history/{{ language }}">← Histórico</a></p><h1>Comparar revisões {{ comparison.from.number }} e {{ comparison.to.number }}</h1><div class="grid">{% for revision in [comparison.from,comparison.to] %}<section class="card"><h2>{{ revision.title }}</h2><p>{{ revision.description }}</p><pre>{{ revision.data|json_encode }}</pre></section>{% endfor %}</div></main></body></html>
