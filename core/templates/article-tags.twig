{# Carry the current reading language into the hashtag archive, even when a card uses a fallback edition.
   Leva o idioma de leitura ao arquivo de hashtags, inclusive quando a chamada exibe uma edição alternativa. #}
{% if tags %}
    {% set label = {pt: 'Hashtags da matéria', en: 'Article hashtags', es: 'Hashtags del artículo'}[language] %}
    <ul class="article-tags" aria-label="{{ label }}">
        {% for tag in tags %}
            <li><a href="/?{{ {tag: tag.key, lang: language}|url_encode }}">#{{ tag.label }}</a></li>
        {% endfor %}
    </ul>
{% endif %}
