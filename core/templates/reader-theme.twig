{% set copy = reader_preferences.text %}
{% set query = query|default({}) %}
{% set icons = {auto: '◐', light: '☀', dark: '☾'} %}
{# A native disclosure works with keyboard and touch. Each link saves its choice through the existing reader preferences.
   O controle nativo funciona com teclado e toque. Cada link salva a escolha pelas preferências de leitura existentes. #}
<details class="reader-theme">
    <summary aria-label="{{ copy.theme }} · {{ copy[reader_preferences.theme] }}" title="{{ copy.theme }}">
        <span aria-hidden="true">{{ icons[reader_preferences.theme] }}</span>
    </summary>
    <nav class="reader-theme-options" aria-label="{{ copy.theme }}">
        {% for mode, icon in icons %}
            <a href="{{ preference_path|default('') }}?{{ query|merge({theme: mode})|url_encode }}"{% if reader_preferences.theme == mode %} aria-current="true"{% endif %}>
                <span aria-hidden="true">{{ icon }}</span> {{ copy[mode] }}
            </a>
        {% endfor %}
    </nav>
</details>
