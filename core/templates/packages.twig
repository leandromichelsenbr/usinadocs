<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pacotes de conteúdo · Usina Docs</title><style>body{font:16px system-ui;margin:2rem;max-width:1000px}.panel{border:1px solid #ccd4e0;border-radius:.6rem;padding:1rem;margin:1rem 0}.ok{background:#e3f4e9}.error{background:#f8e4e4}.warning{background:#fff0cf}table{width:100%;border-collapse:collapse}th,td{padding:.7rem;border-bottom:1px solid #ddd;text-align:left}li{margin:.35rem 0}</style><body><main><p><a href="/admin">← Painel editorial</a></p><h1>Importar pacote de conteúdo</h1><p>Esta etapa apenas valida o pacote e apresenta uma prévia. Nenhuma informação será gravada no banco.</p><form class="panel" method="post" action="/admin/packages/preview" enctype="multipart/form-data"><label>Pacote ZIP <input type="file" name="package" accept=".zip,application/zip" required></label> <button>Validar e visualizar</button></form>{% if error %}<p class="panel error">{{ error }}</p>{% endif %}{% if preview %}<section class="panel {{ preview.valid ? 'ok' : 'error' }}"><h2>{{ filename }}</h2><p><strong>{{ preview.valid ? 'Pacote válido' : 'Pacote inválido' }}</strong></p><ul><li>{{ preview.summary.create }} página(s) nova(s)</li><li>{{ preview.summary.update }} página(s) existente(s)</li><li>{{ preview.summary.revisions }} revisão(ões)</li><li>{{ preview.summary.slug_conflicts }} conflito(s) de slug</li><li>{{ preview.summary.unknown_blocks }} bloco(s) desconhecido(s)</li></ul></section>{% if preview.errors %}<section class="panel error"><h2>Erros</h2><ul>{% for item in preview.errors %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}{% if preview.warnings %}<section class="panel warning"><h2>Avisos</h2><ul>{% for item in preview.warnings %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}<h2>Páginas detectadas</h2><table><thead><tr><th>ID</th><th>Ação prevista</th><th>Idiomas</th><th>Revisões</th></tr></thead><tbody>{% for page in preview.pages %}<tr><td><code>{{ page.id }}</code></td><td>{{ page.action == 'create' ? 'Criar' : 'Atualizar' }}</td><td>{{ page.localizations|keys|join(', ')|upper }}</td><td>{{ page.revisions }}</td></tr>{% endfor %}</tbody></table>{% endif %}</main></body></html>
