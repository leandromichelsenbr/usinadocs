{% set copy = reader_preferences.text %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ profile ? profile.name : copy.authors }} · {{ site_appearance.display_name ?: site_default_name|default('Usina Docs') }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
        main{max-width:49rem}.biography{white-space:pre-wrap;overflow-wrap:anywhere}.languages{margin-block:1rem}
        .author-list li{margin-block:.6rem}
    </style>
</head>
<body><main class="reader-screen">
    <p><a href="/">{{ copy.home }}</a>{% if profile %} · <a href="/{{ locale }}/p/autores">{{ copy.authors }}</a>{% endif %}</p>
    {% set localized_slug = profile ? 'autor-' ~ profile.slug : 'autores' %}
    {% include 'reader-language.twig' with {localized_slug: localized_slug, active_language: locale} only %}
    {% if profile %}
        <h1>{{ profile.name }}</h1>
        {% if biography_language != locale %}<p>{{ copy.author_bio_fallback }}</p>{% endif %}
        <div class="biography" lang="{{ biography_language }}">{{ biography }}</div>
    {% else %}
        <h1>{{ copy.authors }}</h1>
        {% if directory %}
            <ul class="author-list">{% for author in directory %}<li><a href="/{{ locale }}/p/autor-{{ author.slug }}">{{ author.name }}</a></li>{% endfor %}</ul>
        {% else %}
            <p>{{ copy.no_authors }}</p>
        {% endif %}
    {% endif %}
    {# Use the shared public footer on reader and sign-in screens.
       Usa o rodapé público compartilhado nas telas de leitura e de login. #}
    {% include 'public-footer.twig' with {locale: reader_preferences.language} only %}
</main>
{% include 'reader-theme.twig' only %}
</body>
</html>
