/* Keep the alert legible on light and dark cards; the icon remains red in both themes.
   Mantém o alerta legível nos cartões claros e escuros. O ícone é vermelho em ambos os temas. */
.article-critical-label { display: inline-flex; gap: .4em; align-items: center; font-weight: 700; }
.article-critical-icon { display: inline-grid; place-items: center; width: 1.2em; height: 1.2em; border-radius: 50%; background: #b42334; color: #fff; font: 700 1em/1 system-ui, sans-serif; }
