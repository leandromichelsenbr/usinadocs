{% set copy = reader_preferences.text %}
{# Retain the validated return destination while changing preferences.
   Preserva o destino de retorno validado ao alterar as preferências. #}
{% set preference_query = next ? {next: next} : {} %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ copy.login }} · {{ site_appearance.display_name ?: site_default_name|default('Usina Docs') }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'site-logo-style.twig' %}
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
    </style>
</head>
<body><main class="reader-screen">
    {% include 'reader-language.twig' with {query: preference_query} only %}
    <h1>{% include 'site-logo.twig' with {label: site_appearance.display_name ?: site_default_name|default('Usina Docs')} %}</h1>
    <p>{{ copy.login_prompt }}</p>
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    <form class="login-form" method="post" action="/login">
        {# The sign-in handler validates the destination again before redirecting.
           O controlador de login valida novamente o destino antes de redirecionar. #}
        {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}
        <label>{{ copy.email }} <input required type="email" name="email"></label>
        <label>{{ copy.password }} <input required type="password" name="password"></label>
        <button type="submit">{{ copy.login }}</button>
    </form>
    <p><a href="/">{{ copy.home }}</a></p>
    {# Use the shared public footer on reader and sign-in screens.
       Usa o rodapé público compartilhado nas telas de leitura e de login. #}
    {% include 'public-footer.twig' with {locale: reader_preferences.language} only %}
</main>
{% include 'reader-theme.twig' with {query: preference_query} only %}
</body>
</html>
