{% set copy = reader_preferences.text %}
{# Retain the validated return destination while changing preferences.
   Preserva o destino de retorno validado ao alterar as preferências. #}
{% set preference_query = next ? {next: next} : {} %}
{% if failed %}{% set preference_query = preference_query|merge({error: 'oauth'}) %}{% endif %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ copy.login }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'site-logo-style.twig' %}
        {% include 'reader-login-style.twig' %}
        {% include 'reader-controls-style.twig' %}
    </style>
</head>
<body>
<main class="reader-screen">
    {% if site_appearance.display_name or site_appearance.logo_light_id or site_appearance.logo_dark_id %}
        <p>{% include 'site-logo.twig' with {label: site_appearance.display_name ?: site_default_name|default('Usina Docs')} %}</p>
    {% endif %}
    {% include 'reader-language.twig' with {query: preference_query} only %}
    <p><a href="/">{{ copy.home }}</a></p>
    {% if account %}
        <h1>{{ copy.account }}</h1>
        <p>{{ account.name }}</p>
        {% if can_access_editor %}<p><a href="/admin">{{ copy.panel }}</a></p>{% endif %}
        <form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf_token() }}"><button type="submit">{{ copy.sign_out }}</button></form>
    {% else %}
        <h1>{{ copy.login }}</h1>
        {% if failed %}<p role="alert">{{ copy.login_error }}</p>{% endif %}
        <div class="login-links">
            {# Pass the validated return path to the provider route that creates the OAuth attempt.
               Envia o destino de retorno validado à rota do provedor que cria a tentativa OAuth. #}
            {% for provider, label in providers %}
                <a class="provider" href="/auth/{{ provider }}{% if next %}?next={{ next|url_encode }}{% endif %}">{{ copy.provider }} {{ label }}</a>
            {% else %}
                <p>{{ copy.login_unavailable }}</p>
            {% endfor %}
        </div>
    {% endif %}
    {# Use the shared public footer on reader and sign-in screens.
       Usa o rodapé público compartilhado nas telas de leitura e de login. #}
    {% include 'public-footer.twig' with {locale: reader_preferences.language} only %}
</main>
{% include 'reader-theme.twig' with {query: preference_query} only %}
</body>
</html>
