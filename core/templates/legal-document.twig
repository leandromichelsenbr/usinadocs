{% set copy = {
    pt: {home: 'Início', updated: 'Atualizado em', date: 'd/m/Y'},
    en: {home: 'Home', updated: 'Updated on', date: 'M j, Y'},
    es: {home: 'Inicio', updated: 'Actualizado el', date: 'd/m/Y'}
}[locale] %}
{% set site_label = site_appearance.display_name ?: site_default_name|default('Usina Docs') %}
<!doctype html>
<html lang="{{ locale == 'pt' ? 'pt-BR' : locale }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ document.title }} · {{ site_label }}</title>
    {% for code in languages|keys %}
        <link rel="alternate" hreflang="{{ code }}" href="/{{ code }}/p/legal-{{ slug }}">
    {% endfor %}
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'reader-login-style.twig' %}
        {% include 'site-logo-style.twig' %}
        {% include 'reader-controls-style.twig' %}
        main { max-width: 53rem; }
        header, footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; }
        footer { border-top: 1px solid light-dark(#708477, #799386); padding-top: 1rem; }
        .legal-body { white-space: pre-wrap; overflow-wrap: anywhere; margin-block: 1.5rem 2rem; }
    </style>
</head>
<body><main class="reader-screen">
    <header>
        {% include 'site-logo.twig' with {label: site_label, home_locale: locale, home_label: copy.home} %}
        {% include 'reader-language.twig' with {localized_slug: 'legal-' ~ slug, active_language: locale} only %}
    </header>
    <article>
        <h1>{{ document.title }}</h1>
        <p>{{ copy.updated }} <time datetime="{{ document.published_at }}">{{ document.published_at|date(copy.date, site_timezone|default('UTC')) }}</time></p>
        {# Preserve the administrator's line breaks through CSS and let Twig escape the document text.
           Preserva as quebras de linha com CSS e deixa o Twig escapar o texto do documento. #}
        <div class="legal-body">{{ document.body }}</div>
    </article>
    <footer>{% include 'public-footer.twig' with {locale: locale} only %}</footer>
</main>
{% include 'reader-theme.twig' only %}
</body>
</html>
