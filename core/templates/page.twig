<!doctype html>
<html lang="{{ page.language_code|e }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }} · {{ page.site_name }}</title>
    <style>
        :root { color-scheme: light dark; font-family: Inter, system-ui, sans-serif; color: #172033; background: #f3f6fb; }
        body { margin: 0; } main { max-width: 800px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
        header { border-bottom: 1px solid #c7d2e5; padding-bottom: 1rem; margin-bottom: 2.5rem; display:flex; justify-content:space-between; gap:1rem; align-items:start; }
        .brand { color: #1264a3; font-weight: 800; letter-spacing: .03em; } .meta { color: #526174; font-size: .9rem; } .type { display:inline-block; margin-top:.35rem; padding:.15rem .45rem; border-radius:999px; background:#e1edf8; color:#244565; font-size:.8rem; font-weight:700; }
        .languages { display:flex; gap:.4rem; flex-wrap:wrap; justify-content:end; } .languages a,.languages span { border:1px solid #c7d2e5; border-radius:.4rem; padding:.25rem .5rem; color:inherit; font-size:.85rem; text-decoration:none; } .languages span { font-weight:700; border-color:#1264a3; color:#1264a3; }
        h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin-bottom: .6rem; } .summary { color: #3c4a5d; font-size: 1.2rem; line-height: 1.6; }
        section { margin-top:1.6rem; line-height:1.7; } pre { overflow:auto; padding:1rem; border-radius:.6rem; background:#172033; color:#ecf3ff; } .table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:.65rem;border:1px solid #c7d2e5;text-align:left}th{background:#eaf4fc}.citation{margin:1.5rem 0;padding:1rem 1.25rem;border-left:4px solid #1264a3;background:#eaf4fc;border-radius:0 .5rem .5rem 0}.citation p{margin:0 0 .75rem;font-style:italic}.citation footer{font-size:.92rem;color:#3c4a5d}.diagram{padding:1rem;border:1px solid #c7d2e5;border-radius:.6rem;background:#f8fbff}.diagram h2{margin:.1rem 0 1rem}.diagram-nodes{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center}.diagram-node{padding:.45rem .7rem;border:1px solid #1264a3;border-radius:.45rem;background:#eaf4fc;font-weight:650}.diagram-arrow{color:#1264a3;font-weight:800}.diagram-links{margin:.8rem 0 0;padding-left:1.2rem;font-size:.9rem;color:#526174}.quiz{padding:1.25rem;border:1px solid #c7d2e5;border-radius:.6rem;background:#f8fbff}.quiz h2{margin:.1rem 0 .8rem}.quiz-options{display:grid;gap:.55rem}.quiz-option{padding:.65rem .75rem;border:1px solid #c7d2e5;border-radius:.45rem;background:white;text-align:left;cursor:pointer}.quiz-option:hover{border-color:#1264a3}.quiz-feedback{margin:.9rem 0 0;font-weight:650}.quiz-feedback.is-correct{color:#096b2e}.quiz-feedback.is-wrong{color:#8b1f2d}.quiz-explanation{margin:.35rem 0 0;color:#526174}
        @media (prefers-color-scheme: dark) { :root { color: #edf3ff; background: #0e1624; } header { border-color: #32435d; } .brand { color: #7fc7ff; } .meta, .summary,.citation footer,.diagram-links,.quiz-explanation { color: #bfccdc; } th,td{border-color:#32435d}th{background:#1c3854;color:#f2f7ff}td{background:#101d2d;color:#e7effa}.citation{background:#10243a;border-color:#7fc7ff}.diagram{background:#101d2d;border-color:#32435d}.diagram-node{background:#183654;border-color:#7fc7ff}.diagram-arrow{color:#7fc7ff}.quiz{background:#101d2d;border-color:#32435d}.quiz-option{background:#183654;border-color:#32435d;color:#edf3ff}.quiz-option:hover{border-color:#7fc7ff} }
    </style>
</head>
<body>
<main>
    <header><div><div class="brand">{{ page.site_name }}</div><div class="meta">{{ page.native_name }} · Revision {{ page.revision_number }}</div><div class="type">{{ {reference:'Referência técnica',article:'Artigo',lesson:'Aula',class:'Classe',entry_point:'Ponto de entrada'}[page.content_type]|default('Referência técnica') }}</div></div><nav class="languages" aria-label="Idiomas disponíveis">{% for translation in page.translations %}{% if translation.language_code == page.language_code %}<span>{{ translation.language_code|upper }}</span>{% else %}<a href="/{{ translation.language_code }}/p/{{ translation.slug }}">{{ translation.language_code|upper }}</a>{% endif %}{% endfor %}{% if can_edit %}<form method="post" action="/admin/pages/{{ page.page_id }}/revisions/{{ page.language_code }}"><button type="submit">Editar</button></form>{% endif %}</nav></header>
    <article>
        <h1>{{ page.title }}</h1>
        {% if page.summary %}<p class="summary">{{ page.summary }}</p>{% endif %}
        {% for block in page.blocks %}
            <section>
                {% if block.type == 'text' %}
                    {% if block.data.title %}<h2>{{ block.data.title }}</h2>{% endif %}
                    <p>{{ block.data.body }}</p>
                {% elseif block.type == 'heading' %}
                    <h2>{{ block.data.text }}</h2>
                {% elseif block.type == 'code' %}
                    {% if block.data.caption %}<h2>{{ block.data.caption }}</h2>{% endif %}
                    <pre><code>{{ block.data.code }}</code></pre>
                {% elseif block.type == 'table' %}
                    <div class="table-wrap"><table><thead><tr>{% for table_header in block.data.headers %}<th scope="col">{{ table_header }}</th>{% endfor %}</tr></thead><tbody>{% for row in block.data.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
                {% elseif block.type == 'citation' %}
                    <blockquote class="citation"><p>“{{ block.data.text }}”</p><footer>{{ block.data.author }}{% if block.data.year %} ({{ block.data.year }}){% endif %}{% if block.data.work %}. <cite>{{ block.data.work }}</cite>{% endif %}{% if block.data.page %}, p. {{ block.data.page }}{% endif %}{% if block.data.url %}. <a href="{{ block.data.url }}">Fonte</a>{% endif %}</footer></blockquote>
                {% elseif block.type == 'diagram' %}
                    <div class="diagram">{% if block.data.title %}<h2>{{ block.data.title }}</h2>{% endif %}<div class="diagram-nodes">{% for node in block.data.nodes %}<span class="diagram-node">{{ node }}</span>{% if not loop.last %}<span class="diagram-arrow">→</span>{% endif %}{% endfor %}</div>{% if block.data.edges %}<ul class="diagram-links">{% for edge in block.data.edges %}<li>{{ edge }}</li>{% endfor %}</ul>{% endif %}</div>
                {% elseif block.type == 'quiz' %}
                    <div class="quiz" data-answer="{{ block.data.correct|default(0) }}"><h2>{{ block.data.question }}</h2><div class="quiz-options">{% for option in block.data.options %}<button type="button" class="quiz-option" data-choice="{{ loop.index0 }}">{{ option }}</button>{% endfor %}</div><p class="quiz-feedback" hidden></p><p class="quiz-explanation" hidden>{{ block.data.explanation }}</p></div>
                {% elseif block.type == 'image' %}
                    <img src="/media/{{ block.data.id }}" alt="Imagem de apoio" loading="lazy" style="max-width:100%;border-radius:.6rem">
                {% elseif block.type == 'reference' %}
                    <p><strong>Referência:</strong> <a href="{{ block.data.url }}">{{ block.data.title }}</a></p>
                {% elseif block.type == 'notice' %}
                    <aside style="border-left:4px solid #1264a3;padding:.75rem 1rem;background:#eaf4fc">{{ block.data.body }}</aside>
                {% endif %}
            </section>
        {% endfor %}
    </article>
</main>
<script>document.querySelectorAll('.quiz').forEach(quiz=>{quiz.querySelectorAll('.quiz-option').forEach(button=>button.addEventListener('click',()=>{const correct=button.dataset.choice===quiz.dataset.answer,feedback=quiz.querySelector('.quiz-feedback'),explanation=quiz.querySelector('.quiz-explanation');feedback.hidden=false;feedback.textContent=correct?'Resposta correta.':'Ainda não. Revise a explicação abaixo e tente novamente.';feedback.className='quiz-feedback '+(correct?'is-correct':'is-wrong');explanation.hidden=false;}))});</script>
</body>
</html>
