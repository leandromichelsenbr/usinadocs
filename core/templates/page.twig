{% set copy = reader_preferences.text %}
{% set site_label = site_appearance.display_name ?: site_default_name|default(page.site_name) %}
<!doctype html>
<html lang="{{ reader_preferences.language_tag }}" data-theme="{{ reader_preferences.theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }} · {{ site_label }}</title>
    {% include 'site-favicon.twig' %}
    <style>
        {% include 'site-logo-style.twig' %}
        :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; color: #172033; background: #f3f6fb; }
        :root[data-theme="dark"] { color-scheme: dark; }
        @media (prefers-color-scheme: dark) { :root[data-theme="auto"] { color-scheme: dark; } }
        {% include 'reader-settings-style.twig' %}
        {% if site_appearance.accent_color %}main > header { border-top: 3px solid {{ site_appearance.accent_color }}; padding-top: .8rem; }{% endif %}
        body { margin: 0; } main { max-width: 800px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
        header { border-bottom: 1px solid #c7d2e5; padding-bottom: 1rem; margin-bottom: 2.5rem; display:flex; justify-content:space-between; gap:1rem; align-items:start; }
        .brand { color: #1264a3; font-weight: 800; letter-spacing: .03em; } .meta { color: #526174; font-size: .9rem; } .type { display:inline-block; margin-top:.35rem; padding:.15rem .45rem; border-radius:999px; background:#e1edf8; color:#244565; font-size:.8rem; font-weight:700; }
        .languages { display:flex; gap:.4rem; flex-wrap:wrap; justify-content:end; } .languages a,.languages span { border:1px solid #c7d2e5; border-radius:.4rem; padding:.25rem .5rem; color:inherit; font-size:.85rem; text-decoration:none; } .languages span { font-weight:700; border-color:#1264a3; color:#1264a3; }
        h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin-bottom: .6rem; } .summary { color: #3c4a5d; font-size: 1.2rem; line-height: 1.6; }
        section { margin-top:1.6rem; line-height:1.7; } pre { overflow:auto; padding:1rem; border-radius:.6rem; background:#172033; color:#ecf3ff; } .table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:.65rem;border:1px solid #c7d2e5;text-align:left}th{background:#eaf4fc}.citation{margin:1.5rem 0;padding:1rem 1.25rem;border-left:4px solid #1264a3;background:#eaf4fc;border-radius:0 .5rem .5rem 0}.citation p{margin:0 0 .75rem;font-style:italic}.citation footer{font-size:.92rem;color:#3c4a5d}.diagram{padding:1rem;border:1px solid #c7d2e5;border-radius:.6rem;background:#f8fbff}.diagram h2{margin:.1rem 0 1rem}.diagram-nodes{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center}.diagram-node{padding:.45rem .7rem;border:1px solid #1264a3;border-radius:.45rem;background:#eaf4fc;font-weight:650}.diagram-arrow{color:#1264a3;font-weight:800}.diagram-links{margin:.8rem 0 0;padding-left:1.2rem;font-size:.9rem;color:#526174}.quiz{padding:1.25rem;border:1px solid #c7d2e5;border-radius:.6rem;background:#f8fbff}.quiz h2{margin:.1rem 0 .8rem}.quiz-options{display:grid;gap:.55rem}.quiz-option{padding:.65rem .75rem;border:1px solid #c7d2e5;border-radius:.45rem;background:white;text-align:left;cursor:pointer}.quiz-option:hover{border-color:#1264a3}.quiz-feedback{margin:.9rem 0 0;font-weight:650}.quiz-feedback.is-correct{color:#096b2e}.quiz-feedback.is-wrong{color:#8b1f2d}.quiz-explanation{margin:.35rem 0 0;color:#526174}.image-trigger{padding:.65rem .9rem;border:1px solid #1264a3;border-radius:.45rem;background:#eaf4fc;color:#1264a3;font-weight:700;cursor:pointer}.image-trigger:hover{background:#d8ebfa}.content-image{display:block;max-width:100%;height:auto;border:1px solid #c7d2e5;border-radius:.6rem;cursor:zoom-in}.image-modal{width:calc(100vw - 2rem);max-width:1200px;height:calc(100vh - 2rem);padding:0;border:0;border-radius:.7rem;background:#0e1624;color:#edf3ff}.image-modal::backdrop{background:rgba(0,0,0,.72)}.image-modal-content{height:100%;overflow:auto;padding:1rem;box-sizing:border-box}.image-modal-close{position:sticky;top:0;float:right;padding:.45rem .65rem;border:1px solid #7fc7ff;border-radius:.35rem;background:#183654;color:#edf3ff;cursor:pointer}.image-modal img{display:block;max-width:none;height:auto;clear:both;margin:1rem auto 0}
        :root { color: light-dark(#172033, #edf3ff); background: light-dark(#f3f6fb, #0e1624); }
        header, th, td, .languages a, .languages span { border-color: light-dark(#c7d2e5, #32435d); }
        .brand, .languages span { color: light-dark(#1264a3, #7fc7ff); }
        .meta, .summary, .citation footer, .diagram-links, .quiz-explanation { color: light-dark(#526174, #bfccdc); }
        .type { background: light-dark(#e1edf8, #183654); color: light-dark(#244565, #edf3ff); }
        /* Preserve readable table headers in both ways of entering dark mode.
           Preserva a leitura dos cabeçalhos de tabela nas duas formas de ativar o tema escuro. */
        :root[data-theme="dark"] th{background:#1c3854;color:#f2f7ff}
        @media (prefers-color-scheme: dark) { :root[data-theme="auto"] th{background:#1c3854;color:#f2f7ff} }
        .notice { background: light-dark(#eaf4fc, #1c3854); }
        td { background: light-dark(transparent, #101d2d); }
        .citation, .diagram, .quiz { background: light-dark(#eaf4fc, #10243a); border-color: light-dark(#1264a3, #7fc7ff); }
        .diagram-node, .quiz-option { background: light-dark(#fff, #183654); color: light-dark(#172033, #edf3ff); }
        .quiz-option:hover { border-color: light-dark(#1264a3, #7fc7ff); }
        .notice { border-left: 4px solid light-dark(#1264a3, #7fc7ff); padding: .75rem 1rem; }
        .reader-tools { display: grid; gap: .7rem; justify-items: end; }
        @media (max-width: 38rem) { header { flex-wrap: wrap; } .reader-tools { justify-items: start; } }
        .editorial-media { margin: 0; }
        .editorial-media figcaption { margin-block: .45rem; font-size: .9rem; }
        .youtube-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border: 0; }
        .article-byline { display: grid; gap: .3rem; border-block: 1px solid light-dark(#c7d2e5, #32435d); padding: .75rem 0; margin-block: 1rem; font-size: .92rem; }
        .article-byline a { color: inherit; text-underline-offset: .2em; }
        /* Keep comments readable across themes and prevent long strings from widening the article.
           Mantém os comentários legíveis nos temas e impede que textos longos alarguem o artigo. */
        .article-comments { border-top: 1px solid light-dark(#c7d2e5, #32435d); margin-top: 3rem; }
        .article-comments a { color: light-dark(#1264a3, #7fc7ff); }
        .article-comment { padding: 1rem; margin-block: .75rem; border-radius: .6rem; background: light-dark(#eaf4fc, #10243a); overflow-wrap: anywhere; }
        .article-comment p { margin-bottom: 0; white-space: pre-wrap; }
        .article-comment time { font-size: .85rem; }
        .article-comments form { display: grid; gap: .55rem; margin-top: 1.5rem; }
        .article-comments textarea, .article-comments button { font: inherit; padding: .45rem .7rem; }
        .article-comments button { justify-self: start; }
    </style>
</head>
<body>
<main>
    <header><div><div class="brand">{% include 'site-logo.twig' with {label: site_label} %}</div><div class="meta">{{ page.native_name }} · {{ copy.revision }} {{ page.revision_number }}</div><div class="type">{{ copy[page.content_type]|default(copy.reference) }}</div></div><div class="reader-tools"><nav class="languages" aria-label="{{ copy.available_languages }}">{% for translation in page.translations %}{% if translation.language_code == page.language_code %}<span>{{ translation.language_code|upper }}</span>{% else %}<a href="/{{ translation.language_code }}/p/{{ translation.slug }}">{{ translation.language_code|upper }}</a>{% endif %}{% endfor %}{% if oauth_enabled %}<a href="/login">{{ account ? copy.account : copy.login }}</a>{% endif %}{% if can_edit %}<form method="post" action="/admin/pages/{{ page.page_id }}/revisions/{{ page.language_code }}"><button type="submit">{{ copy.edit }}</button></form>{% endif %}</nav>{% include 'reader-settings.twig' %}</div></header>
    {% if page.language_code != reader_preferences.language and reader_preferences.language not in page.translations|map(item => item.language_code) %}
        <p class="meta">{{ copy.translation_unavailable }}</p>
    {% endif %}
    {% if editorial_preview %}<p role="status">Prévia editorial</p>{% endif %}
    <article lang="{{ page.language_code }}">
        <h1>{{ page.title }}</h1>
        {% if page.summary %}<p class="summary">{{ page.summary }}</p>{% endif %}
        {% if page.content_type == 'article' %}{% include 'article-byline.twig' %}{% endif %}
        {# Only the public article route supplies interaction data. Editorial previews stay free of counters and forms.
           Apenas a rota pública de artigos fornece dados de interação. As prévias editoriais ficam sem contadores e formulários. #}
        {% if engagement is defined and engagement is not null and engagement.views is not null %}
            {% set view_copy = {
                pt: ['visualização', 'visualizações', ',', '.'],
                en: ['view', 'views', '.', ','],
                es: ['visualización', 'visualizaciones', ',', '.']
            }[page.language_code] %}
            <p class="meta article-views">{{ engagement.views|number_format(0, view_copy[2], view_copy[3]) }} {{ engagement.views == 1 ? view_copy[0] : view_copy[1] }}</p>
        {% endif %}
        {% for block in page.blocks %}
            <section>
                {% if block.type == 'text' %}
                    {% if block.data.title %}<h2>{{ block.data.title }}</h2>{% endif %}
                    <p>{{ block.data.body }}</p>
                {% elseif block.type == 'heading' %}
                    <h2>{{ block.data.text }}</h2>
                {% elseif block.type == 'code' %}
                    {% if block.data.caption %}<h2>{{ block.data.caption }}</h2>{% endif %}
                    <pre><code>{{ block.data.code }}</code></pre>
                {% elseif block.type == 'table' %}
                    <div class="table-wrap"><table><thead><tr>{% for table_header in block.data.headers %}<th scope="col">{{ table_header }}</th>{% endfor %}</tr></thead><tbody>{% for row in block.data.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
                {% elseif block.type == 'citation' %}
                    <blockquote class="citation"><p>“{{ block.data.text }}”</p><footer>{{ block.data.author }}{% if block.data.year %} ({{ block.data.year }}){% endif %}{% if block.data.work %}. <cite>{{ block.data.work }}</cite>{% endif %}{% if block.data.page %}, p. {{ block.data.page }}{% endif %}{% if block.data.url %}. <a href="{{ block.data.url }}">{{ copy.source }}</a>{% endif %}</footer></blockquote>
                {% elseif block.type == 'diagram' %}
                    <div class="diagram">{% if block.data.title %}<h2>{{ block.data.title }}</h2>{% endif %}<div class="diagram-nodes">{% for node in block.data.nodes %}<span class="diagram-node">{{ node }}</span>{% if not loop.last %}<span class="diagram-arrow">→</span>{% endif %}{% endfor %}</div>{% if block.data.edges %}<ul class="diagram-links">{% for edge in block.data.edges %}<li>{{ edge }}</li>{% endfor %}</ul>{% endif %}</div>
                {% elseif block.type == 'quiz' %}
                    <div class="quiz" data-answer="{{ block.data.correct|default(0) }}"><h2>{{ block.data.question }}</h2><div class="quiz-options">{% for option in block.data.options %}<button type="button" class="quiz-option" data-choice="{{ loop.index0 }}">{{ option }}</button>{% endfor %}</div><p class="quiz-feedback" hidden></p><p class="quiz-explanation quiz-correct-explanation" hidden>{{ block.data.explanation }}</p><p class="quiz-explanation quiz-error-explanation" hidden>{{ block.data.error_explanation }}{% if block.data.error_url %} <a href="{{ block.data.error_url }}">{{ copy.review }}</a>{% endif %}</p></div>
                {% elseif block.type == 'youtube' and block.data.video_id %}
                    {# Build the embed from the validated identifier and keep a link when playback is unavailable.
                       Monta a incorporação com o identificador validado e mantém um link se a reprodução estiver indisponível. #}
                    <figure class="editorial-media">
                        <iframe class="youtube-video" width="560" height="315"
                            src="https://www.youtube-nocookie.com/embed/{{ block.data.video_id }}"
                            title="{{ block.data.title|default(copy.video) }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
                            allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
                        {% if block.data.caption %}<figcaption>{{ block.data.caption }}</figcaption>{% endif %}
                        <p><a href="https://www.youtube.com/watch?v={{ block.data.video_id }}">{{ copy.watch_video }}</a></p>
                    </figure>
                {% elseif block.type == 'image' %}
                    {# An illustration's alternative text and caption belong to its localized block.
                       O texto alternativo e a legenda de uma ilustração pertencem ao bloco localizado. #}
                    {% set image_url = '/media/' ~ block.data.id %}
                    {% set image_label = block.data.button_label|default(copy.load_image) %}
                    {% set image_alt = block.data.alt|default(copy.image_alt) %}
                    <figure class="editorial-media">
                        {% if block.data.display|default('static') == 'on_demand' %}
                            <button type="button" class="image-trigger" data-image-src="{{ image_url }}" data-image-label="{{ image_label }}" data-image-alt="{{ image_alt }}">{{ image_label }}</button>
                        {% else %}
                            <img src="{{ image_url }}" alt="{{ image_alt }}" loading="lazy" class="content-image" data-image-src="{{ image_url }}">
                        {% endif %}
                        {% if block.data.caption %}<figcaption>{{ block.data.caption }}</figcaption>{% endif %}
                    </figure>
                {% elseif block.type == 'reference' %}
                    <p><strong>{{ copy.reference_label }}:</strong> <a href="{{ block.data.url }}">{{ block.data.title }}</a></p>
                {% elseif block.type == 'notice' %}
                    <aside class="notice">{{ block.data.body }}</aside>
                {% elseif block.type == 'missing_artifact' %}
                    {% if can_edit %}<aside style="border:1px solid #8b1f2d;padding:.75rem 1rem">{{ block.data.title }}</aside>{% endif %}
                {% endif %}
            </section>
        {% endfor %}
    </article>
    {% if engagement %}{% include 'article-comments.twig' %}{% endif %}
    {# Share the published legal navigation on reader and sign-in screens.
       Compartilha a navegação legal publicada nas telas de leitura e de login. #}
    {% include 'legal-links.twig' with {locale: reader_preferences.language} only %}
</main>
<dialog class="image-modal" id="image-modal"><div class="image-modal-content"><button type="button" class="image-modal-close">{{ copy.close }}</button><img alt="{{ copy.full_image }}"></div></dialog>
<script>document.querySelectorAll('.quiz').forEach(quiz=>{quiz.querySelectorAll('.quiz-option').forEach(button=>button.addEventListener('click',()=>{const correct=button.dataset.choice===quiz.dataset.answer,feedback=quiz.querySelector('.quiz-feedback'),correctExplanation=quiz.querySelector('.quiz-correct-explanation'),errorExplanation=quiz.querySelector('.quiz-error-explanation');feedback.hidden=false;feedback.textContent=correct?{{ copy.correct|json_encode|raw }}:{{ copy.incorrect|json_encode|raw }};feedback.className='quiz-feedback '+(correct?'is-correct':'is-wrong');correctExplanation.hidden=!correct;errorExplanation.hidden=correct;}))});const imageModal=document.querySelector('#image-modal'),modalImage=imageModal.querySelector('img');function openImage(source){modalImage.src=source;imageModal.showModal()}document.querySelector('.image-modal-close').addEventListener('click',()=>imageModal.close());imageModal.addEventListener('click',event=>{if(event.target===imageModal)imageModal.close()});document.querySelectorAll('.image-trigger').forEach(button=>button.addEventListener('click',()=>{const image=document.createElement('img');image.src=button.dataset.imageSrc;image.alt=button.dataset.imageAlt||{{ copy.image_alt|json_encode|raw }};image.loading='lazy';image.className='content-image';image.dataset.imageSrc=button.dataset.imageSrc;image.addEventListener('click',()=>openImage(image.dataset.imageSrc));button.replaceWith(image)}));document.querySelectorAll('.content-image').forEach(image=>image.addEventListener('click',()=>openImage(image.dataset.imageSrc||image.src)));</script>
</body>
</html>
