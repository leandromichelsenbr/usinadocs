<!doctype html>
<html lang="{{ page.language_code|e }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }} · {{ page.site_name }}</title>
    <style>
        :root { color-scheme: light dark; font-family: Inter, system-ui, sans-serif; color: #172033; background: #f3f6fb; }
        body { margin: 0; } main { max-width: 800px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
        header { border-bottom: 1px solid #c7d2e5; padding-bottom: 1rem; margin-bottom: 2.5rem; display:flex; justify-content:space-between; gap:1rem; align-items:start; }
        .brand { color: #1264a3; font-weight: 800; letter-spacing: .03em; } .meta { color: #526174; font-size: .9rem; } .type { display:inline-block; margin-top:.35rem; padding:.15rem .45rem; border-radius:999px; background:#e1edf8; color:#244565; font-size:.8rem; font-weight:700; }
        .languages { display:flex; gap:.4rem; flex-wrap:wrap; justify-content:end; } .languages a,.languages span { border:1px solid #c7d2e5; border-radius:.4rem; padding:.25rem .5rem; color:inherit; font-size:.85rem; text-decoration:none; } .languages span { font-weight:700; border-color:#1264a3; color:#1264a3; }
        h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin-bottom: .6rem; } .summary { color: #3c4a5d; font-size: 1.2rem; line-height: 1.6; }
        section { margin-top: 1.6rem; line-height: 1.7; } pre { overflow: auto; padding: 1rem; border-radius: .6rem; background: #172033; color: #ecf3ff; } .table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:.65rem;border:1px solid #c7d2e5;text-align:left}th{background:#eaf4fc}
        @media (prefers-color-scheme: dark) { :root { color: #edf3ff; background: #0e1624; } header { border-color: #32435d; } .brand { color: #7fc7ff; } .meta, .summary { color: #bfccdc; } }
    </style>
</head>
<body>
<main>
    <header><div><div class="brand">{{ page.site_name }}</div><div class="meta">{{ page.native_name }} · Revision {{ page.revision_number }}</div><div class="type">{{ {reference:'Referência técnica',article:'Artigo',lesson:'Aula',class:'Classe',entry_point:'Ponto de entrada'}[page.content_type]|default('Referência técnica') }}</div></div><nav class="languages" aria-label="Idiomas disponíveis">{% for translation in page.translations %}{% if translation.language_code == page.language_code %}<span>{{ translation.language_code|upper }}</span>{% else %}<a href="/{{ translation.language_code }}/p/{{ translation.slug }}">{{ translation.language_code|upper }}</a>{% endif %}{% endfor %}{% if can_edit %}<form method="post" action="/admin/pages/{{ page.page_id }}/revisions/{{ page.language_code }}"><button type="submit">Editar</button></form>{% endif %}</nav></header>
    <article>
        <h1>{{ page.title }}</h1>
        {% if page.summary %}<p class="summary">{{ page.summary }}</p>{% endif %}
        {% for block in page.blocks %}
            <section>
                {% if block.type == 'text' %}
                    {% if block.data.title %}<h2>{{ block.data.title }}</h2>{% endif %}
                    <p>{{ block.data.body }}</p>
                {% elseif block.type == 'heading' %}
                    <h2>{{ block.data.text }}</h2>
                {% elseif block.type == 'code' %}
                    {% if block.data.caption %}<h2>{{ block.data.caption }}</h2>{% endif %}
                    <pre><code>{{ block.data.code }}</code></pre>
                {% elseif block.type == 'table' %}
                    <div class="table-wrap"><table><thead><tr>{% for table_header in block.data.headers %}<th scope="col">{{ table_header }}</th>{% endfor %}</tr></thead><tbody>{% for row in block.data.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
                {% elseif block.type == 'image' %}
                    <img src="/media/{{ block.data.id }}" alt="Imagem de apoio" loading="lazy" style="max-width:100%;border-radius:.6rem">
                {% elseif block.type == 'reference' %}
                    <p><strong>Referência:</strong> <a href="{{ block.data.url }}">{{ block.data.title }}</a></p>
                {% elseif block.type == 'notice' %}
                    <aside style="border-left:4px solid #1264a3;padding:.75rem 1rem;background:#eaf4fc">{{ block.data.body }}</aside>
                {% endif %}
            </section>
        {% endfor %}
    </article>
</main>
</body>
</html>
