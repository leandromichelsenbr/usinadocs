<!doctype html><html lang="pt"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mídia · Usina Docs</title><body><main><h1>Biblioteca de mídia</h1><p>Envie imagens JPEG, PNG ou WebP de até 5 MB. Registre origem e licença para manter a rastreabilidade editorial.</p><form method="post" action="/admin/media" enctype="multipart/form-data"><label>Arquivo <input type="file" name="file" accept="image/jpeg,image/png,image/webp" required></label><label>Título <input name="title" required></label><label>URL de origem <input name="source_url" type="url"></label><label>Autoria/licença <input name="license_note"></label><button>Enviar imagem</button></form><h2>Arquivos enviados</h2>{% for item in media %}<article><img src="/media/{{ item.id }}" alt="" width="120" loading="lazy"><strong>{{ item.title }}</strong><span>{{ item.mime_type }} · {{ item.byte_size }} bytes</span>{% if item.source_url %}<a href="{{ item.source_url }}">Origem</a>{% endif %}<span>{{ item.license_note }}</span></article>{% else %}<p>Nenhuma mídia enviada.</p>{% endfor %}<p><a href="/admin">Voltar ao painel</a></p></main></body></html>
